  <suggestionSettings>
    <suggestionSetting type="Class" typeId="04e12b51-ed12-42a3-9667-a6aa81bb6d10" locations="diagram, model">
      <name>Create CRUD CQRS Services in Services designer</name>
      <filterFunction>return application.isModuleInstalled("Intent.Modelers.Services.CQRS");</filterFunction>
      <dependencies />
      <script>if (!await promptIfUnsavedChangesAsync()) {
    return;
}
await navigateToDesigner("81104ae6-2bc5-4bae-b05a-f987b0372d81", {
    executeScript: `await CrudApi.createCQRSService(getPackages().find(x =&gt; x.specializationId == "df45eaf6-9202-4c25-8dd5-677e9ba1e906"), lookup('${element.id}'));`,
    scriptDependencies: ["b044459e-f779-4648-aed3-9ed169c11362"]
});</script>
    </suggestionSetting>
    <suggestionSetting type="Class" typeId="04e12b51-ed12-42a3-9667-a6aa81bb6d10" locations="diagram, model">
      <name>Create CRUD Traditional Service in Services designer</name>
      <dependencies />
      <script>if (!await promptIfUnsavedChangesAsync()) {
    return;
}

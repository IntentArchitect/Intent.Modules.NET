{
  "id": "intent.domain",
  "version": "1.0.0",
  "description": "Domain designer vocabulary: structure",
  "requires": [{ "id": "intent.core", "version": "^1.0.0" }],
  "languages": ["csharp"],
  "designers": ["Domain"],
  "kinds": [
    { "kind": "repository.entity", "label": "repository entity", "valueType": "type", "comparer": "type", "stated": "always" },
    { "kind": "repository.implementation", "label": "repository implementation", "valueType": "presence", "comparer": "presence", "stated": "always", "existence": true }
  ],
  "vocabulary": {
    "Domain": {
      "designer": "Domain",
      "entries": [
        { "kind": "type.exists", "for": { "element": "Class" }, "value": "self", "bindings": { "Name": "name" }, "own": ["Name"], "source": "the class" },
        { "kind": "type.kind", "for": { "element": "Class" }, "dependsOn": "type.exists", "source": "the element type" },
        { "kind": "type.abstract", "for": { "element": "Class" }, "value": "abstract", "dependsOn": "type.exists", "source": "the class's Abstract" },
        { "kind": "type.generalization", "for": { "element": "Class" }, "value": "join(map(where(associations('Generalization'), isTarget), type.name), ', ')", "dependsOn": "type.exists", "source": "the class's Generalization" },
        { "kind": "type.exists", "for": { "element": "Enum" }, "value": "self", "bindings": { "Name": "name" }, "own": ["Name"], "source": "the enum" },
        { "kind": "type.kind", "for": { "element": "Enum" }, "dependsOn": "type.exists", "source": "the element type" },
        { "kind": "member.exists", "for": { "element": "Attribute" }, "value": "self", "dependsOn": "parent:type.exists", "source": "the attribute" },
        { "kind": "member.type", "for": { "element": "Attribute" }, "value": "type", "dependsOn": "member.exists", "source": "the attribute's type" },
        { "kind": "member.nullable", "for": { "element": "Attribute" }, "value": "type.isNullable", "dependsOn": "member.exists", "source": "the attribute's Is Nullable" },
        { "kind": "member.static", "for": { "element": "Attribute" }, "value": "static", "dependsOn": "member.exists", "source": "the attribute's Static" },
        { "kind": "member.exists", "for": { "element": "Operation" }, "value": "self", "dependsOn": "parent:type.exists", "source": "the operation" },
        { "kind": "member.static", "for": { "element": "Operation" }, "value": "static", "dependsOn": "member.exists", "source": "the operation's Static" },
        { "kind": "operation.returns", "for": { "element": "Operation" }, "value": "type", "dependsOn": "member.exists", "source": "the operation's return type" },
        { "kind": "operation.nullable", "for": { "element": "Operation", "where": "exists(type.name)" }, "value": "type.isNullable", "dependsOn": "member.exists", "waitsOn": ["operation.returns"], "source": "the operation's return type's Is Nullable" },
        { "kind": "operation.parameters", "for": { "element": "Operation" }, "dependsOn": "member.exists", "source": "the operation's parameters" },
        { "kind": "member.exists", "for": { "element": "Class Constructor" }, "value": "self", "dependsOn": "parent:type.exists", "source": "the constructor" },
        { "kind": "operation.parameters", "for": { "element": "Class Constructor" }, "dependsOn": "member.exists", "source": "the constructor's parameters" },
        { "kind": "parameter.nullable", "for": { "element": "Parameter" }, "value": "type.isNullable", "dependsOn": "parent:member.exists", "source": "the parameter's Is Nullable" },
        { "kind": "parameter.default", "for": { "element": "Parameter" }, "value": "value", "dependsOn": "parent:member.exists", "source": "the parameter's default value" },
        { "kind": "enum.literals", "for": { "element": "Enum" }, "value": "join(map(children('Enum-Literal'), name), ', ')", "dependsOn": "type.exists", "waitsOn": ["type.kind"], "source": "the enum's literals" },
        { "kind": "enum.literal.value", "for": { "element": "Enum-Literal" }, "value": "value", "dependsOn": "parent:type.exists", "source": "the literal's value" },
        { "kind": "member.exists", "for": { "associationEnd": "Association" }, "value": "self", "dependsOn": "parent:type.exists", "source": "the association end" },
        { "kind": "member.type", "for": { "associationEnd": "Association" }, "value": "type", "dependsOn": "member.exists", "source": "the association end's type and multiplicity" },
        { "kind": "member.nullable", "for": { "associationEnd": "Association", "where": "!type.isCollection" }, "value": "type.isNullable", "dependsOn": "member.exists", "source": "the association end's multiplicity" },
        { "kind": "type.exists", "for": { "element": "Domain Event" }, "value": "self", "bindings": { "Name": "name" }, "own": ["Name"], "source": "the domain event" },
        { "kind": "type.kind", "for": { "element": "Domain Event" }, "dependsOn": "type.exists", "source": "the element type" },
        { "kind": "member.exists", "for": { "element": "Property" }, "value": "self", "dependsOn": "parent:type.exists", "source": "the property" },
        { "kind": "member.type", "for": { "element": "Property" }, "value": "type", "dependsOn": "member.exists", "source": "the property's type" },
        { "kind": "member.nullable", "for": { "element": "Property" }, "value": "type.isNullable", "dependsOn": "member.exists", "source": "the property's Is Nullable" },
        { "kind": "type.exists", "for": { "element": "Value Object" }, "value": "self", "bindings": { "Name": "name" }, "own": ["Name"], "source": "the value object" },
        { "kind": "type.kind", "for": { "element": "Value Object" }, "dependsOn": "type.exists", "source": "the element type" },
        { "kind": "type.exists", "for": { "element": "Domain Service" }, "value": "self", "bindings": { "Name": "name" }, "own": ["Name"], "source": "the domain service" },
        { "kind": "type.exists", "for": { "element": "Data Contract" }, "value": "self", "bindings": { "Name": "name" }, "own": ["Name"], "source": "the data contract" },
        { "kind": "type.kind", "for": { "element": "Data Contract" }, "dependsOn": "type.exists", "source": "the element type" },
        { "kind": "type.exists", "for": { "element": "Repository" }, "value": "self", "bindings": { "Name": "name" }, "own": ["Name"], "source": "the repository" },
        { "kind": "repository.entity", "for": { "element": "Repository", "where": "exists(type.name)" }, "value": "type", "dependsOn": "type.exists", "source": "the repository's type" },
        { "kind": "repository.implementation", "for": { "element": "Repository" }, "value": "self", "dependsOn": "type.exists", "source": "the repository" }
      ],
      "nonClaims": [
        { "for": { "stereotype": "[Static Constructor]" }, "reason": "Marks a static operation that creates its class; that it is static (member.static) and what it returns (operation.returns) are checked." }
      ]
    }
  },
  "conventions": {
    "Domain": {
      "designer": "Domain",
      "types": {
        "Class": { "typeKinds": ["class", "record"], "states": ["property", "field", "constructor", "method"] },
        "Enum": { "typeKinds": ["enum"], "states": ["enumMember"] },
        "Domain Event": { "typeKinds": ["class", "record"], "states": ["property", "field"] },
        "Value Object": { "typeKinds": ["class", "record", "struct"], "states": ["property", "field"] },
        "Repository": { "typeKinds": ["interface", "class"], "states": ["method"] },
        "Domain Service": { "typeKinds": ["class"], "states": ["method"] },
        "Data Contract": { "typeKinds": ["class", "record"], "states": ["property", "field"] }
      }
    }
  }
}

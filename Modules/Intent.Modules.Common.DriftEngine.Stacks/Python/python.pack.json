      "untyped": {
        "notStated": "Python states a type only in an annotation, and these have none; annotate them to check them."
      },
      "naming": { "property": "{Name|snake}", "field": "{Name|snake}", "method": "{Name|snake}", "parameter": "{Name|snake}" },

  <moduleSettings>
    <group id="cfc23486-153d-4d9d-9e0b-cfeb1754e382" title="Domain Guardrails Contracts Settings" type="application-settings" externalReference="cfc23486-153d-4d9d-9e0b-cfeb1754e382">
      <settings>
        <setting id="4bfe1393-e432-4171-870a-3f662cc61898" title="Default Type Modifiers" type="select">
          <hint>The modifiers every class and record contract is declared with, unless its Type Configuration sets Modifiers. An option without public or internal declares types without an access modifier, and none declares them with no modifiers at all. sealed is left off abstract types and types another modelled type inherits from. Enums take only the access modifier, unless their Enum Configuration sets one.</hint>
          <defaultValue>public</defaultValue>
          <options>
            <option value="public" description="public" />
            <option value="internal" description="internal" />
            <option value="public sealed" description="public sealed" />
            <option value="internal sealed" description="internal sealed" />
            <option value="public partial" description="public partial" />
            <option value="internal partial" description="internal partial" />
            <option value="public sealed partial" description="public sealed partial" />
            <option value="internal sealed partial" description="internal sealed partial" />
            <option value="none" description="none" />
            <option value="sealed" description="sealed" />
            <option value="partial" description="partial" />
            <option value="sealed partial" description="sealed partial" />
          </options>
        </setting>
      </settings>
    </group>
  </moduleSettings>
  <interoperability>

{
  "$schema": "../../Intent.Modules.Common.DriftEngine/docs/spec/schemas/conversion-map.schema.json",
  // What each Common.Drift recipe-file construct becomes (conversion.md). The conversion test derives these keys from the
  // local recipe files and fails on any the map lacks. "change" names a row of conversion.md's Semantic changes.
  "constructs": {
    "file.facts": { "becomes": "moved", "to": "the house pack's rules section for the designer" },
    "file.files": { "becomes": "moved", "to": "the rules section's files" },
    "file.own": { "becomes": "moved", "to": "unmodelled.* opt-in conventions, with a proposed Opt-in Rules row", "change": 9 },
    "file.exceptions": { "becomes": "proposed", "to": "Drift Scope Out rows and Drift Check Exceptions rows" },
    "file.note": { "becomes": "same", "note": "Kept" },

    "files.string": { "becomes": "proposed", "to": "the rules section's files, plus a proposed Drift Scope In row" },
    "files.list": { "becomes": "proposed", "to": "the rules section's files, plus a proposed Drift Scope In row per pattern" },

    "kind.table.name": { "becomes": "same" },
    "kind.table.schema": { "becomes": "same" },
    "kind.table.kind": { "becomes": "same" },
    "kind.key": { "becomes": "same" },
    "kind.column.name": { "becomes": "same" },
    "kind.column.type": { "becomes": "same" },
    "kind.column.textType": { "becomes": "same" },
    "kind.column.maxLength": { "becomes": "same" },
    "kind.column.required": { "becomes": "alias", "to": "member.nullable", "change": 11 },
    "kind.column.precision": { "becomes": "same" },
    "kind.column.scale": { "becomes": "same" },
    "kind.column.default": { "becomes": "same" },
    "kind.relationship.multiplicity": { "becomes": "same", "change": 12 },
    "kind.relationship.foreignKey": { "becomes": "same" },
    "kind.index.columns": { "becomes": "same", "change": 5 },
    "kind.index.unique": { "becomes": "same", "change": 5 },
    "kind.intent.raises": { "becomes": "same" },
    "kind.service.route": { "becomes": "same" },
    "kind.operation.verb": { "becomes": "same" },
    "kind.operation.route": { "becomes": "same" },
    "kind.security": { "becomes": "same" },
    "kind.security.roles": { "becomes": "same" },
    "kind.security.policy": { "becomes": "same" },
    "kind.parameter.source": { "becomes": "same" },
    "kind.intent.creates": { "becomes": "same" },
    "kind.intent.updates": { "becomes": "same" },
    "kind.intent.deletes": { "becomes": "same" },
    "kind.intent.queries": { "becomes": "same" },
    "kind.intent.invokes": { "becomes": "same" },
    "kind.intent.publishes": { "becomes": "same" },
    "kind.intent.sends": { "becomes": "same" },
    "kind.component.kind": { "becomes": "same", "note": "Vocabulary from the intent.ui pack (phase 6)" },
    "kind.page.route": { "becomes": "same", "note": "Vocabulary from the intent.ui pack (phase 6)" },
    "kind.intent.navigates": { "becomes": "same", "note": "Vocabulary from the intent.ui pack (phase 6)" },
    "kind.intent.opens": { "becomes": "same", "note": "Vocabulary from the intent.ui pack (phase 6)" },
    "kind.intent.uses": { "becomes": "same", "note": "Vocabulary from the intent.ui pack (phase 6)" },

    "recipe.find.string": { "becomes": "same" },
    "recipe.find.list": { "becomes": "same", "note": "Tried in order" },
    "recipe.read": { "becomes": "same" },
    "recipe.default": {
      "becomes": "same",
      "change": 1,
      "note": "Same for always kinds. On a whenSet kind a literal default is dropped and listed (change 1), and an empty one is dropped (change 2)."
    },
    "recipe.absent": { "becomes": "same", "change": 1, "note": "As default" },
    "recipe.unstated": { "becomes": "same", "note": "Quoted when a reading is silence" },
    "recipe.inherit.string": { "becomes": "same" },
    "recipe.inherit.list": { "becomes": "same", "note": "Undocumented in Common.Drift; the engine documents it" },
    "recipe.inherit.value.class": { "becomes": "same" },
    "recipe.inherit.value.base": { "becomes": "same" },
    "recipe.inherit.value.method": { "becomes": "same" },
    "recipe.inherit.value.property": { "becomes": "same" },
    "recipe.inherit.value.statement": { "becomes": "same" },
    "recipe.inherit.value.file": { "becomes": "same" },
    "recipe.inherit.value.findPath": { "becomes": "same" },
    "recipe.replace": { "becomes": "same", "note": "default isn't passed through replace, as in Common.Drift" },
    "recipe.files.string": { "becomes": "same", "note": "Narrows within scope" },
    "recipe.files.list": { "becomes": "same", "note": "Narrows within scope" },
    "recipe.case.upper": { "becomes": "same" },
    "recipe.case.lower": { "becomes": "same" },
    "recipe.note": { "becomes": "same", "note": "Kept" },

    "case.match": { "becomes": "same" },
    "case.value": { "becomes": "same", "note": "$1, ${name} and placeholders" },
    "case.part.declaration": { "becomes": "same" },
    "case.part.body": { "becomes": "same" },
    "case.in.class": { "becomes": "same" },
    "case.in.method": { "becomes": "same" },
    "case.in.statement": { "becomes": "same" },
    "case.in.property": { "becomes": "same", "note": "None of the five codebases uses it" },
    "case.in.parameter": { "becomes": "same", "note": "None of the five codebases uses it" },
    "case.in.file": { "becomes": "same", "note": "None of the five codebases uses it" },
    "case.case.upper": { "becomes": "same" },
    "case.case.lower": { "becomes": "same", "note": "None of the five codebases uses it" },
    "case.unreadable": { "becomes": "same", "note": "Can't verify, unreadable" },
    "case.note": { "becomes": "same", "note": "Kept" },

    "step.class": { "becomes": "alias", "to": "type:" },
    "step.with.class": { "becomes": "alias", "to": "type with" },
    "step.bare.class": { "becomes": "alias", "to": "type", "note": "None of the five codebases uses it" },
    "step.method": { "becomes": "same", "note": "Overloads chosen by parameter names" },
    "step.method.overload": { "becomes": "same", "note": "None of the five codebases uses it" },
    "step.with.method": { "becomes": "same" },
    "step.bare.method": { "becomes": "same", "note": "None of the five codebases uses it" },
    "step.property": { "becomes": "same" },
    "step.with.property": { "becomes": "same" },
    "step.bare.property": { "becomes": "same", "note": "None of the five codebases uses it" },
    "step.parameter": { "becomes": "same" },
    "step.with.parameter": { "becomes": "same" },
    "step.bare.parameter": { "becomes": "same", "note": "None of the five codebases uses it" },
    "step.statement": { "becomes": "same" },
    "step.with.statement": { "becomes": "same" },
    "step.bare.statement": { "becomes": "same", "note": "None of the five codebases uses it" },
    "step.chain": { "becomes": "same", "note": "None of the five codebases uses it" },
    "step.with.chain": { "becomes": "same" },
    "step.file": { "becomes": "same", "note": "Component files read as one unit" },
    "step.with.file": { "becomes": "same" },
    "step.bare.file": { "becomes": "same", "note": "None of the five codebases uses it" },

    "filter.camel": { "becomes": "same" },
    "filter.pascal": { "becomes": "same", "note": "None of the five codebases uses it" },
    "filter.kebab": { "becomes": "same", "note": "None of the five codebases uses it" },
    "filter.lower": { "becomes": "same", "note": "None of the five codebases uses it" },
    "filter.upper": { "becomes": "same", "note": "None of the five codebases uses it" },
    "filter.trimStart": { "becomes": "same" },
    "filter.trimEnd": { "becomes": "same" },
    "filter.replace": { "becomes": "same" },
    "filter.chain.2": { "becomes": "same" },
    "filter.chain.3": { "becomes": "same" },
    "filter.chain.4": { "becomes": "same" },

    "regex.lookbehind": { "becomes": "same", "note": "The engine runs .NET's regular expressions for every language" },
    "regex.backreference": { "becomes": "same", "note": "The engine runs .NET's regular expressions for every language" },
    "regex.inlineIgnoreCase": { "becomes": "same", "note": "The engine runs .NET's regular expressions for every language" },
    "regex.scopedIgnoreCase": { "becomes": "same", "note": "The engine runs .NET's regular expressions for every language" },
    "regex.namedGroup": { "becomes": "same", "note": "The engine runs .NET's regular expressions for every language" },

    "own.kind": { "becomes": "moved", "to": "the convention's kind", "change": 9 },
    "own.find": {
      "becomes": "moved",
      "to": "an unmodelled.type convention; member-level finds become unmodelled.member or unmodelled.interaction conventions",
      "change": 9
    },
    "own.step.with.class": { "becomes": "moved", "to": "an unmodelled.type convention's find", "change": 9 },
    "own.step.with.method": { "becomes": "moved", "to": "an unmodelled.member convention's find", "change": 9 },
    "own.step.with.statement": { "becomes": "moved", "to": "an unmodelled.interaction convention's find", "change": 9 },
    "own.step.with.chain": { "becomes": "moved", "to": "an unmodelled.interaction convention's find", "change": 9 },
    "own.step.with.file": { "becomes": "moved", "to": "an unmodelled.file convention's find", "change": 9 },
    "own.name": { "becomes": "same", "note": "The same naming in the opt-in rule's findings" },
    "own.name.group2plus": { "becomes": "same", "note": "The same naming in the opt-in rule's findings" },
    "own.files": { "becomes": "moved", "to": "the convention's files" },
    "own.note": { "becomes": "same", "note": "Kept" },

    "exception.object": { "becomes": "proposed", "to": "a Drift Scope Out row or a Drift Check Exceptions row, by its form" },
    "exception.string": { "becomes": "flagged", "note": "A bare pattern has no reason; the proposed row needs one (config/exceptionReason)" },
    "exception.file": { "becomes": "proposed", "to": "a Drift Scope Out row with the exception's reason" },
    "exception.member": { "becomes": "proposed", "to": "a Drift Check Exceptions row for the matching opt-in rule" },
    "exception.typeOrName": { "becomes": "proposed", "to": "a Drift Check Exceptions row for the matching opt-in rule" },
    "exception.noReason": { "becomes": "flagged", "note": "The proposed row needs a reason (config/exceptionReason)" }
  }
}

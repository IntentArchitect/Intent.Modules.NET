    <group id="a0dc28dc-5b2f-493c-aa67-b9fe1bc72fc3" title="RoslynWeaver Settings">
      <module>Intent.OutputManager.RoslynWeaver</module>
      <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
      <settings>
        <setting id="8d4b5f59-7947-4afa-8f51-83314f84afb3" title="Auto Format by Default" module="Intent.OutputManager.RoslynWeaver" type="switch">
          <value>true</value>
          <isRequired>false</isRequired>
          <options />
        </setting>
        <setting id="dd4e7dcb-9b4c-47ed-8cbe-c8e36bcd2be3" title="Default Attributes Mode" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Default when not otherwise specified in the template and/or existing file. Falls back to Signature Mode if unspecified.</hint>
          <value>unspecified</value>
          <isRequired>false</isRequired>
          <options>
            <option value="unspecified" description="Unspecified" />
            <option value="fully" description="Fully" />
            <option value="merge" description="Merge" />
            <option value="ignore" description="Ignore" />
          </options>
        </setting>
        <setting id="212d4e5e-0c03-47c1-8e99-3ea4f64d5842" title="Default Body Mode" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Default when not otherwise specified in the template and/or existing file.</hint>
          <value>unspecified</value>
          <isRequired>false</isRequired>
          <options>
            <option value="unspecified" description="Unspecified" />
            <option value="fully" description="Fully" />
            <option value="merge" description="Merge" />
            <option value="ignore" description="Ignore" />
          </options>
        </setting>
        <setting id="2068d5ff-1698-46d9-a59f-494f7de98d45" title="Default Comments Mode" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Default when not otherwise specified in the template and/or existing file. Falls back to Signature Mode if unspecified.</hint>
          <value>unspecified</value>
          <isRequired>false</isRequired>
          <options>
            <option value="unspecified" description="Unspecified" />
            <option value="fully" description="Fully" />
            <option value="merge" description="Merge" />
            <option value="ignore" description="Ignore" />
          </options>
        </setting>
        <setting id="78af1295-66fa-4495-9588-5e184cc82e30" title="Default Mode" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Default when not otherwise specified in the template and/or existing file.</hint>
          <value>unspecified</value>
          <isRequired>false</isRequired>
          <options>
            <option value="unspecified" description="Unspecified" />
            <option value="fully" description="Fully" />
            <option value="merge" description="Merge" />
            <option value="ignore" description="Ignore" />
          </options>
        </setting>
        <setting id="a8bb9294-ef8a-4f5f-80dd-4b768f98cbc4" title="Default Signature Mode" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Default when not otherwise specified in the template and/or existing file.</hint>
          <value>unspecified</value>
          <isRequired>false</isRequired>
          <options>
            <option value="unspecified" description="Unspecified" />
            <option value="fully" description="Fully" />
            <option value="merge" description="Merge" />
            <option value="ignore" description="Ignore" />
          </options>
        </setting>
        <setting id="decfd76e-16be-46f3-a698-daa57fba27dd" title="Default Tag Mode" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Default when not otherwise specified in the template and/or existing file.</hint>
          <value>Explicit</value>
          <isRequired>false</isRequired>
          <options>
            <option value="Explicit" description="Explicit" />
            <option value="Implicit" description="Implicit" />
            <option value="TemplateOnly" description="Template Only" />
          </options>
        </setting>
        <setting id="2f3bb97b-7348-4eb1-b4c7-beda3d1bda6b" title="Merge Behaviour" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Whether to remove items which are no longer in the unmerged template output.</hint>
          <value>remove-from-existing-when-was-being-generated</value>
          <isRequired>false</isRequired>
          <options>
            <option value="remove-from-existing-never" description="Never remove items from existing files" />
            <option value="remove-from-existing-when-was-being-generated" description="Remove items from existing files which are no longer being generated (recommended)" />
          </options>
        </setting>
        <setting id="75da3fda-a64d-4161-a8a2-38614053fb1d" title="Namespace Declaration Style" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Controls whether or not namespace declarations should be file scoped.</hint>
          <value>default</value>
          <isRequired>false</isRequired>
          <options>
            <option value="default" description="No preference" />
            <option value="prefer-file-scoped" description="Prefer use of file scoped namespace declarations" />
            <option value="disallow-file-scoped" description="Disallow use of file scoped namespace declarations" />
          </options>
        </setting>
        <setting id="afa8d194-f64f-4e56-8edd-b4ba7edca268" title="Usings Placement" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Controls the placement of using directives within the file.</hint>
          <value>Default</value>
          <isRequired>false</isRequired>
          <options>
            <option value="Default" description="Default" />
            <option value="MoveToInsideNamespace" description="Move to inside namespace" />
          </options>
        </setting>
        <setting id="edccf04e-c2da-4f3b-b1d1-d7008d5fb6d9" title="Usings Sorting" module="Intent.OutputManager.RoslynWeaver" type="select">
          <hint>Controls how the using directives are sorted.</hint>
          <value>AlphabeticalSystemFirst</value>
          <isRequired>false</isRequired>
          <options>
            <option value="None" description="None" />
            <option value="Alphabetical" description="Alphabetical" />
            <option value="AlphabeticalSystemFirst" description="Alphabetical, place 'System' directives first" />
          </options>
        </setting>
      </settings>
    </group>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Intent.Modules.Guardrails.Contracts.Tests" />
  </ItemGroup>


  <ItemGroup>
    <!-- Supplied at run time by Intent.OutputManager.RoslynWeaver's lib folder (Roslyn 5.0), so it isn't shipped. Keep it at or below that version. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Intent.Modules.Common" Version="3.11.1" />
    <PackageReference Include="Intent.Modules.Common.CSharp" Version="3.10.12-pre.2" />
    <PackageReference Include="Intent.Modules.Modelers.Services" Version="4.0.17-pre.2" />
    <PackageReference Include="Intent.Modules.Modelers.Services.CQRS" Version="6.0.8" />
    <PackageReference Include="Intent.Packager" Version="3.6.2-pre.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Intent.RoslynWeaver.Attributes" Version="3.0.0" />
    <PackageReference Include="Intent.SoftwareFactory.SDK" Version="3.14.0-pre.1" />
  </ItemGroup>

</Project>
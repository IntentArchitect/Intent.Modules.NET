@page "/Account/Manage/SetPassword"

@using Microsoft.AspNetCore.Identity

@inject UserManager<<#= IdentityClass #>> UserManager
@inject SignInManager<<#= IdentityClass #>> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Set password</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Set your password</MudText>
<StatusMessage Message="@message" />
<MudAlert Severity="Severity.Info" Class="mb-3">
    You do not have a local username/password for this site. Add a local
    account so you can log in without an external login.
</MudAlert>

<MudCard Class="auth-form-card">
    <MudCardContent>
        <EditForm Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <MudTextField Label="New password" For="@(() => Input.NewPassword)" @bind-Value="Input.NewPassword"
                          InputType="InputType.Password" Required="true" RequiredError="New password is required"
                          AutoComplete="new-password" Class="mb-3" />
            <MudTextField Label="Confirm password" For="@(() => Input.ConfirmPassword)" @bind-Value="Input.ConfirmPassword"
                          InputType="InputType.Password" AutoComplete="new-password" Class="mb-3" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">Set password</MudButton>
        </EditForm>
    </MudCardContent>
</MudCard>

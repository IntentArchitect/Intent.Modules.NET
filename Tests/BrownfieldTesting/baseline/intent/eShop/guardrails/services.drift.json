          "match": "[\\[,]Authorize\\((?:Policy=)?\"([^\"]*)\""
        },
        {
          "match": "\\.MapGroup\\([^;]*?\\.RequireAuthorization\\(((?:\"[^\"]*\",)*\"[^\"]*)\"\\)(?:(?!\\.MapGroup\\().)*?\\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\"[^;]*?(?:[(,\\]](?:\\w+\\.)*{Operation}(?: \\w+)?[,)]|\\.WithName\\(\"{Operation}\"\\))"
        }
      ],
      "replace": [
        {
          "match": "[\"\\s]",
          "with": ""
        }
      ],
      "inherit": [
        "method",
        "class:{Service} > method:{Operation}"
      ],
      "default": "",
      "unstated": "no policy in `RequireAuthorization` on the endpoint or its group, or in its handler's `[Authorize]`"
    },
    "parameter.source": {
      "find": [
        "class:{Service} > statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",(?:\\w+\\.)*{Operation}\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\([^;]*?\\.WithName\\(\"{Operation}\"\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",[^;]*?[(,\\]]{Operation} \\w+[,)]"
      ],
      "read": [
        {
          "match": "[\\[,]From(Body|Route|Query|Form|Header)\\b",
          "value": "From $1"
        },
        {
          "match": "^(?:\\[[^\\]]*\\])*\\[(?:AsParameters|FromServices|FromKeyedServices)\\b",
          "value": "Default",
          "note": "A parameter bag or a service: not an HTTP source"
        },
        {
          "match": "^(?:\\[[^\\]]*\\])*(?:HttpContext|HttpRequest|HttpResponse|ClaimsPrincipal|CancellationToken|\\w+Context|I[A-Z]\\w*)\\b",
          "value": "Default",
          "note": "A special or DI-injected parameter (HttpContext, a DbContext, an interface): not an HTTP source"
        },
        {
          "match": "(?<!\\[AsParameters\\])[(,]{Operation} \\w+[,)]",
          "value": "From Body"
        },
        {
          "match": "(?<=\\(\"[^\"]*)(?i:\\{{Parameter}(?::[^}]*)?\\??\\})",
          "value": "From Route"
        },
        {
          "match": "^(?:\\[[^\\]]*\\])*(?:IFormFile|IFormFileCollection)\\b",
          "value": "From Form"
        },
        {
          "match": "(?<=^(?:\\[[^\\]]*\\])*(?:public (?:required )?)?)(?:string|int|long|short|byte|bool|decimal|double|float|char|DateTime|DateTimeOffset|DateOnly|TimeOnly|TimeSpan|Guid)\\b",
          "value": "From Query"
        }
      ],
      "inherit": [
        "class:{Service} > method:{Operation} > parameter:{Parameter}",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\([^;]*?\\.WithName\\(\"{Operation}\"\\) > parameter:{Parameter}",
        "class:{Operation} > property:{Parameter}"
      ],
      "default": "From Body",
      "unstated": "no `[From…]` attribute or route parameter, and not a simple type, so minimal APIs bind it from the body"
    },
    "intent.creates": {
      "find": [
        "class:{Service} > method with \\b(?:Handle|HandleAsync|Consume)\\({Operation} [^)]*\\).*?\\bnew {Entity}\\b",
        "class:{Service} > method:{Operation}",
        "class:{Service} > method with [(<]{Operation}[ >]",
        "class with [:,]I(?:Request|Command|Query)Handler<{Operation}[,>] > method with \\bHandle(?:Async)?\\({Operation} "
      ],
      "read": [
        {
          "part": "body",
          "match": "\\bnew ({Entity})\\b"
        },
        {
          "part": "body",
          "match": "\\b({Entity})\\.{Member}\\("
        },
        {
          "part": "body",
          "match": "\\.Add({Entity})\\("
        }
      ],
      "default": "",
      "unstated": "no `new {Entity}`, factory call or `Add{Entity}(…)` in the handler",
      "note": "The first find path picks, among same-named handler classes in different services (e.g. OrderStatusChangedToPaidIntegrationEventHandler in Catalog, Webhooks and WebApp), the Handle method whose body performs the modelled interaction. When none does, the later paths match several classes and the fact is reported as can't be verified."
    },

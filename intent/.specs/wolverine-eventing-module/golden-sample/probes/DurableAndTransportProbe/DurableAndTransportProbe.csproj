    <PackageReference Include="WolverineFx.SqlServer" Version="5.39.5" />
    <PackageReference Include="WolverineFx.Postgresql" Version="5.39.5" />
    <PackageReference Include="WolverineFx.AzureServiceBus" Version="5.39.5" />
    <PackageReference Include="WolverineFx.AmazonSqs" Version="5.39.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
  </ItemGroup>

</Project>

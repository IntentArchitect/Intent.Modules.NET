<?xml version="1.0" encoding="utf-8"?>
<package>
  <id>Intent.Application.Dtos.ObjectMapping</id>
  <version>1.0.0</version>
  <supportedClientVersions>[5.0.0-a, 6.0.0)</supportedClientVersions>
  <summary>Generates explicit C# object mapping extension methods for DTOs mapped from domain entities, producing readable, refactor-safe code with no runtime reflection or third-party mapping library dependency.</summary>
  <description>Generates explicit C# object mapping extension methods for DTOs mapped from domain entities, producing readable, refactor-safe code with no runtime reflection or third-party mapping library dependency.</description>
  <authors>Intent Architect</authors>
  <iconUrl>data:image/svg+xml;base64,</iconUrl>
  <templates>
    <template id="Intent.Application.Dtos.ObjectMapping.MappingExtensions" externalReference="2cc27b23-c495-44be-870b-a0854490f1ce">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Application.Mappings</role>
      <location>Mappings</location>
    </template>
  </templates>
  <decorators></decorators>
  <factoryExtensions />
  <moduleSettings>
    <group id="27e1bf22-ac74-4e15-b5d9-cc1342530dab" title="Object Mapping" type="application-settings" externalReference="27e1bf22-ac74-4e15-b5d9-cc1342530dab">
      <settings>
        <setting id="0d9f5223-c911-4afd-bb7d-89e5bd13a48c" title="Null Path Handling" type="select">
          <hint>Governs what a mapping path that crosses a nullable hop into a non-nullable DTO field emits.</hint>
          <defaultValue>strict</defaultValue>
          <options>
            <option value="strict" description="Strict" />
            <option value="lenient" description="Lenient" />
          </options>
        </setting>
      </settings>
    </group>
  </moduleSettings>
  <interoperability>
    <detect id="Intent.Application.DomainInteractions">
      <install>
        <package id="Intent.Application.DomainInteractions" version="1.2.10" />
      </install>
    </detect>
  </interoperability>
  <dependencies>
    <dependency id="Intent.Application.Dtos" version="4.2.1" />
    <dependency id="Intent.Common" version="3.7.2" />
    <dependency id="Intent.Common.CSharp" version="3.8.0" />
    <dependency id="Intent.Common.Types" version="3.4.0" />
    <dependency id="Intent.Modelers.Services" version="4.0.4" />
    <dependency id="Intent.OutputManager.RoslynWeaver" version="4.5.1" />
  </dependencies>
  <files>
    <file src="$outDir$/$id$.dll" />
    <file src="$outDir$/$id$.pdb" />
  </files>
  <tags>mapping dto csharp dotnet application objectmapping</tags>
  <projectUrl>https://docs.intentarchitect.com/articles/modules-dotnet/intent-application-dtos-objectmapping/intent-application-dtos-objectmapping.html</projectUrl>
  <releaseNotes>release-notes.md</releaseNotes>
  <moduleSettingsExtensions />
  <metadata />
  <migrations />
</package>
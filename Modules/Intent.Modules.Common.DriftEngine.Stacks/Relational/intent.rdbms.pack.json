{
  "id": "intent.rdbms",
  "version": "1.0.0",
  "description": "Relational databases: tables, keys, columns, indexes and foreign keys, from Intent's RDBMS stereotypes. Framework extensions read them from code.",
  "requires": [{ "id": "intent.domain", "version": "^1.0.0" }],
  "designers": ["Domain"],
  "kinds": [
    { "kind": "entity.persisted", "label": "persisted", "valueType": "bool", "comparer": "exact", "stated": "always" },
    { "kind": "table.name", "label": "table", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "table.schema", "label": "schema", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "key", "label": "primary key", "valueType": "list", "comparer": "list", "stated": "always" },
    { "kind": "index.columns", "label": "columns", "valueType": "list", "comparer": "exact", "stated": "always" },
    { "kind": "index.unique", "label": "unique", "valueType": "bool", "comparer": "exact", "stated": "always" },
    { "kind": "index.filter", "label": "filter", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "relationship.foreignKey", "label": "foreign key", "valueType": "list", "comparer": "list", "stated": "whenSet" },
    { "kind": "relationship.multiplicity", "label": "multiplicity", "valueType": "text", "comparer": "exact", "stated": "always" },
    { "kind": "column.textType", "label": "text type", "valueType": "text", "comparer": "ignoreCase", "stated": "always" },
    { "kind": "table.kind", "label": "table or view", "valueType": "text", "comparer": "exact", "stated": "always" },
    { "kind": "column.name", "label": "column", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "column.type", "label": "column type", "valueType": "text", "comparer": "storeType", "stated": "whenSet" },
    { "kind": "column.maxLength", "label": "max length", "valueType": "number", "comparer": "number", "stated": "whenSet" },
    { "kind": "column.precision", "label": "precision", "valueType": "number", "comparer": "number", "stated": "whenSet" },
    { "kind": "column.scale", "label": "scale", "valueType": "number", "comparer": "number", "stated": "whenSet" },
    { "kind": "column.default", "label": "default", "valueType": "text", "comparer": "literal", "stated": "whenSet" },
    { "kind": "key.generated", "label": "key generation", "valueType": "text", "comparer": "exact", "stated": "whenSet" }
  ],
  "vocabulary": {
    "Domain": {
      "designer": "Domain",
      "entries": [
        { "kind": "entity.persisted", "for": { "element": "Class", "where": "hasStereotype('Table') || hasStereotype('View')" }, "value": "'true'", "dependsOn": "type.exists", "source": "the class's Table or View stereotype" },
        { "kind": "table.name", "for": { "element": "Class", "where": "hasStereotype('Table')" }, "value": "stereotype('Table').Name", "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Table Name" },
        { "kind": "table.schema", "for": { "element": "Class", "where": "hasStereotype('Table')" }, "value": "stereotype('Table').Schema ?? enclosing('Schema').Name", "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Table Schema, else the Schema stereotype on its folder or package" },
        { "kind": "key", "for": { "element": "Class", "where": "count(where(children('Attribute'), hasStereotype('Primary Key'))) != '0'" }, "value": "join(map(where(children('Attribute'), hasStereotype('Primary Key')), name), ', ')", "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Primary Key attributes" },
        { "kind": "table.name", "for": { "element": "Class", "where": "hasStereotype('View')" }, "value": "stereotype('View').Name", "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's View Name" },
        { "kind": "table.schema", "for": { "element": "Class", "where": "hasStereotype('View')" }, "value": "stereotype('View').Schema ?? enclosing('Schema').Name", "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's View Schema, else the Schema stereotype on its folder or package" },
        { "kind": "table.kind", "for": { "element": "Class", "where": "hasStereotype('View')" }, "value": "'View'", "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's View stereotype" },
        { "kind": "table.kind", "for": { "element": "Class", "where": "hasStereotype('Table') && !hasStereotype('View')" }, "value": "'Table'", "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Table stereotype" },
        { "kind": "column.name", "for": { "element": "Attribute", "where": "hasStereotype('Column')" }, "value": "stereotype('Column').Name", "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Column Name" },
        { "kind": "column.type", "for": { "element": "Attribute", "where": "hasStereotype('Column')" }, "value": "stereotype('Column').Type", "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Column Type" },
        { "kind": "index.columns", "for": { "element": "Index" }, "value": "join(map(children('Index Column'), name), ', ')", "dependsOn": "parent:type.exists", "waitsOn": ["parent:entity.persisted"], "source": "the index's columns" },
        { "kind": "index.unique", "for": { "element": "Index" }, "value": "stereotype('Settings').Unique", "dependsOn": "parent:type.exists", "waitsOn": ["parent:entity.persisted"], "source": "the index's Unique" },
        { "kind": "index.filter", "for": { "element": "Index", "where": "stereotype('Settings').Filter == 'Custom'" }, "value": "stereotype('Settings')['Filter Custom Value']", "dependsOn": "parent:type.exists", "waitsOn": ["parent:entity.persisted"], "source": "the index's Filter Custom Value" },
        { "kind": "column.textType", "for": { "element": "Attribute", "where": "type.name == 'string' && (hasStereotype('Text Constraints') || parent.hasStereotype('Table') && !exists(stereotype('Column').Type))" }, "value": "stereotype('Text Constraints')['SQL Data Type'] ?? 'DEFAULT'", "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Text Constraints SQL Data Type, DEFAULT without one" },
        { "kind": "column.maxLength", "for": { "element": "Attribute", "where": "hasStereotype('Text Constraints')" }, "value": "stereotype('Text Constraints').MaxLength", "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Text Constraints MaxLength" },
        { "kind": "column.precision", "for": { "element": "Attribute", "where": "hasStereotype('Decimal Constraints')" }, "value": "stereotype('Decimal Constraints').Precision", "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Decimal Constraints Precision" },
        { "kind": "column.scale", "for": { "element": "Attribute", "where": "hasStereotype('Decimal Constraints')" }, "value": "stereotype('Decimal Constraints').Scale", "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Decimal Constraints Scale" },
        { "kind": "column.default", "for": { "element": "Attribute", "where": "hasStereotype('Default Constraint')" }, "value": "stereotype('Default Constraint').Value", "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Default Constraint Value" },
        { "kind": "key.generated", "for": { "element": "Attribute", "where": "hasStereotype('Primary Key') && stereotype('Primary Key')['Data source'] != 'Default'" }, "value": "stereotype('Primary Key')['Data source']", "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Primary Key Data source" }
      ],
      "nonClaims": [
        { "for": { "stereotype": "Relational Database" }, "reason": "Marks the package as stored in a relational database; what that states, its tables, keys, columns and indexes, is checked." }
      ]
    }
  }
}

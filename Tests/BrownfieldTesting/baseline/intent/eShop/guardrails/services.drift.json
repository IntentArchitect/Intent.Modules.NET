  "own": [
    {
      "kind": "endpoint",
      "find": "statement with \\.Map(Get|Post|Put|Delete|Patch)\\(\"([^\"]*)\",\\w+\\)",
      "name": "{Class}: Map$1 $2",
      "note": "Method-group endpoints only. An inline-lambda endpoint (Catalog catalogtypes/catalogbrands, every Webhooks.API and WebhookClient endpoint) has no method a Service operation could describe: the Services templates generate one method per operation, so modelling a lambda would insert a method."
    },
    {
      "kind": "Command",
      "note": "Ordering's MediatR commands",
      "find": "class with \\b(?:class|record) \\w+(?:<[^>]*>)?(?:\\([^)]*\\))?:IRequest<",
      "files": "src/Ordering.API/Application/Commands/*.cs"
    },
    {
      "kind": "Integration Event",
      "find": "class with :IntegrationEvent\\b",
      "files": [
        "src/Ordering.API/Application/IntegrationEvents/Events/*.cs",
        "src/Catalog.API/IntegrationEvents/Events/*.cs",
        "src/Webhooks.API/IntegrationEvents/*.cs",
        "src/Basket.API/IntegrationEvents/Events/*.cs",
        "src/OrderProcessor/Events/*.cs",
        "src/PaymentProcessor/IntegrationEvents/Events/*.cs",
        "src/WebApp/Services/OrderStatus/IntegrationEvents/Events/*.cs"
      ]
    },
    {
      "kind": "Integration Event Handler",
      "find": "class with :IIntegrationEventHandler<",
      "files": [
        "src/Ordering.API/Application/IntegrationEvents/EventHandling/*.cs",
        "src/Catalog.API/IntegrationEvents/EventHandling/*.cs",
        "src/Webhooks.API/IntegrationEvents/*.cs",
        "src/Basket.API/IntegrationEvents/EventHandling/*.cs",
        "src/PaymentProcessor/IntegrationEvents/EventHandling/*.cs",
        "src/WebApp/Services/OrderStatus/IntegrationEvents/EventHandling/*.cs"
      ]
    },
    {
      "kind": "Domain Event Handler",
      "find": "class with :INotificationHandler<",
      "files": "src/Ordering.API/Application/DomainEventHandlers/*.cs"
    }
  ],
  "exceptions": [
    {
      "match": "IdentifiedCommand",
      "reason": "Generic idempotency wrapper IdentifiedCommand<T, R>: a Command element can't declare type parameters."
    },
    {
      "match": "CatalogApi.MapCatalogApi",
      "reason": "Extension method (this IEndpointRouteBuilder) that maps the endpoints: the model can't declare a `this` parameter. Its Map calls are described by the CatalogApi operations' Http Settings."
    },
    {
      "match": "OrdersApi.MapOrdersApiV1",
      "reason": "Extension method (this IEndpointRouteBuilder) that maps the endpoints: the model can't declare a `this` parameter. Its Map calls are described by the OrdersApi operations' Http Settings."
    }
  ]
}

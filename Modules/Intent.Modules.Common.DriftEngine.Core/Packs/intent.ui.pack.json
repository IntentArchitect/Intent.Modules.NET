        { "kind": "type.exists", "for": { "element": "Dialog" }, "value": "self", "bindings": { "Name": "name", "Component": "name", "Folder": "if(parent.specialization == 'Folder', parent.name, '')", "Path": "stereotype('Implementation').Path" }, "own": ["Name", "Component", "Folder"], "source": "the dialog" },

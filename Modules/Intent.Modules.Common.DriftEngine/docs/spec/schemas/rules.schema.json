{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.intentarchitect.com/driftengine/rules.schema.json",
  "title": "Rules",
  "description": "A pack's rules for one designer: recipes in Common.Drift's format with additions, queries, and plug-in rules (rules.md). In a single-file pack, the `rules` section holds one of these per designer, keyed by designer, without `designer`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "designer": { "type": "string", "minLength": 1 },
    "files": { "$ref": "#/$defs/files" },
    "facts": {
      "type": "object",
      "propertyNames": { "$ref": "claim-kinds.schema.json#/$defs/kindId" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/rule" },
          { "type": "array", "items": { "$ref": "#/$defs/rule" }, "minItems": 1, "description": "Several rules for one kind, each narrowed by its own `for`" }
        ]
      }
    },
    "note": { "type": "string" }
  },
  "$defs": {
    "rule": {
      "oneOf": [
        { "$ref": "#/$defs/recipe" },
        { "$ref": "#/$defs/queryRule" },
        { "$ref": "#/$defs/pluginRule" }
      ]
    },
    "files": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ]
    },
    "common": {
      "type": "object",
      "properties": {
        "for": { "$ref": "vocabulary.schema.json#/$defs/selector" },
        "replaces": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*/[a-z][A-Za-z.]*$" },
        "compare": { "$ref": "claim-kinds.schema.json#/$defs/comparer" },
        "note": { "type": "string" }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["find", "read"],
      "allOf": [{ "$ref": "#/$defs/common" }],
      "properties": {
        "find": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }] },
        "read": { "type": "array", "items": { "$ref": "#/$defs/readCase" }, "minItems": 1 },
        "default": { "type": "string" },
        "absent": { "type": "string" },
        "unstated": { "type": "string" },
        "inherit": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
        "replace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["match", "with"],
            "additionalProperties": false,
            "properties": { "match": { "type": "string" }, "with": { "type": "string" }, "note": { "type": "string" } }
          }
        },
        "map": { "type": "object", "additionalProperties": { "type": "string" } },
        "case": { "$ref": "#/$defs/case" },
        "files": { "$ref": "#/$defs/files" },
        "matches": { "enum": ["one", "any"], "description": "any: for presence and bool kinds, several places read the first in path and line order instead of ambiguous" }
      },
      "unevaluatedProperties": false
    },
    "case": { "enum": ["upper", "lower", "pascal", "camel"] },
    "readCase": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["match"] }, { "required": ["node"] }],
      "properties": {
        "match": { "type": "string", "minLength": 1, "description": "A .NET regular expression over canonical text" },
        "node": { "type": "string", "minLength": 1, "description": "A field path on the found node, such as arguments[0].literal" },
        "value": { "type": "string" },
        "part": { "enum": ["declaration", "body"] },
        "in": { "enum": ["class", "method", "property", "parameter", "statement", "file"] },
        "case": { "$ref": "#/$defs/case" },
        "unreadable": { "type": "boolean" },
        "note": { "type": "string" }
      },
      "if": { "properties": { "unreadable": { "const": true } }, "required": ["unreadable"] },
      "then": { "not": { "required": ["value"] } }
    },
    "queryRule": {
      "type": "object",
      "required": ["query"],
      "allOf": [{ "$ref": "#/$defs/common" }],
      "properties": {
        "query": { "$ref": "query.schema.json" },
        "absent": { "type": "string", "description": "The value of a claim no row reaches, as silence; with item, \"\" is an empty list or set" }
      },
      "unevaluatedProperties": false
    },
    "pluginRule": {
      "type": "object",
      "required": ["plugin"],
      "allOf": [{ "$ref": "#/$defs/common" }],
      "properties": {
        "plugin": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*/[A-Za-z][A-Za-z0-9.]*$", "description": "<pack>/<claim reader id>" },
        "arguments": { "type": "object" }
      },
      "unevaluatedProperties": false
    }
  }
}

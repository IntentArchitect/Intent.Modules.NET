{
  "$schema": "../../Intent.Modules.Common.DriftEngine/docs/spec/schemas/conversion-map.schema.json",
  // What each Common.Drift recipe-file construct becomes (conversion.md). The conversion test derives these keys from the
  // local recipe files and fails on any the map lacks. "change" names a row of conversion.md's Semantic changes. The engine
  // has no recipes: a fact is its kind's reader's, so a recipe's find and read constructs are dropped (change 13). Opt-in
  // conventions are globs only (user, 2026-11-16), so an own entry's find steps, filters and regular expressions are dropped
  // too. Intent.Common.Drift 2.0's migration writes the rows ("moved"; user, 2026-11-23).
  "constructs": {
    "file.facts": { "becomes": "dropped", "change": 13, "note": "Each fact is its kind's stock reader's, or noRule until the house's module reads it" },
    "file.files": { "becomes": "dropped", "note": "One Drift Scope In row for ** covers the code v1 checked" },
    "file.own": { "becomes": "moved", "to": "optin/unmodelled.type Opt-in Rules rows", "change": 9 },
    "file.exceptions": { "becomes": "moved", "to": "Drift Scope Out rows and Drift Check Exceptions rows" },
    "file.note": { "becomes": "dropped", "note": "Stays in git history" },

    "files.string": { "becomes": "dropped", "note": "The ** In row covers it" },
    "files.list": { "becomes": "dropped", "note": "The ** In row covers it" },

    "kind.table.name": { "becomes": "same" },

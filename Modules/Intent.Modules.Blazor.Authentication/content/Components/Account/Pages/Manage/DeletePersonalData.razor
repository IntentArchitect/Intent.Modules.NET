@page "/Account/Manage/DeletePersonalData"

@using Microsoft.AspNetCore.Identity

@inject UserManager<<#= IdentityClass #>> UserManager
@inject SignInManager<<#= IdentityClass #>> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Delete Personal Data</PageTitle>

<StatusMessage Message="@message" />

<h3>Delete personal data</h3>

<div class="ux-callout ux-callout-danger" role="alert">
    <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
</div>

<EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />
    @if (requirePassword)
    {
        <UxField Label="Password" Icon="lock" For="password">
            <InputText id="password" type="password" @bind-Value="Input.Password" class="ux-input" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
        </UxField>
        <ValidationMessage For="() => Input.Password" class="text-danger" />
    }
    <button class="w-100 btn btn-lg btn-danger" type="submit">
        <UxIcon Name="trash" />
        Delete data and close my account
    </button>
</EditForm>

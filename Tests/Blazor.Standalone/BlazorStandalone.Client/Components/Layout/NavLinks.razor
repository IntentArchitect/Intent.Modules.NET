@* Shared presentational nav links — the MudBlazor design language (MudNavMenu/MudNavLink)
   rendered from a nav-item model. A "dumb" component: data down only, no state, no routing
   decisions, no render-mode awareness — so the SAME component renders identically in the
   interactive MudDrawer shell and the static-SSR <aside> account shell. (MudNavLink renders
   fine statically — it's a route-aware <a>.) *@

<MudNavMenu>
    @foreach (var item in Items)
    {
        <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="@GetMatch(item)">@item.Label</MudNavLink>
    }
</MudNavMenu>

        { "kind": "operation.returns", "for": { "element": "Operation", "where": "parent.specialization != 'Type-Definition'" }, "value": "type", "dependsOn": "member.exists", "source": "the operation's return type" },
        { "kind": "operation.parameters", "for": { "element": "Operation", "where": "parent.specialization != 'Type-Definition'" }, "dependsOn": "member.exists", "source": "the operation's parameters" },
        { "kind": "intent.uses", "for": { "association": "Composition" }, "value": "self", "bindings": { "Component": "if(source.element.specialization == 'Component Operation' || source.element.specialization == 'Region', source.element.parent.name, source.element.name)", "Child": "target.element.name" }, "own": ["Component", "Child"], "source": "its Composition" },
        { "kind": "intent.target", "for": { "association": "Composition" }, "value": "target.element", "dependsOn": "intent.uses", "source": "the component its Composition targets" },

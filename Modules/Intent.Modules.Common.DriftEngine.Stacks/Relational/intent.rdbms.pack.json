{
  "id": "intent.rdbms",
  "version": "1.0.0",
  "description": "Relational databases: tables, keys, columns, indexes and foreign keys, from Intent's RDBMS stereotypes. Framework extensions read them from code.",
  "requires": [{ "id": "intent.domain", "version": "^1.0.0" }],
  "designers": ["Domain"],
  "kinds": [
    { "kind": "entity.persisted", "label": "persisted", "valueType": "bool", "comparer": "exact", "stated": "always" },
    { "kind": "table.name", "label": "table", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "table.schema", "label": "schema", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "key", "label": "primary key", "valueType": "list", "comparer": "list", "stated": "always" },
    { "kind": "index.columns", "label": "columns", "valueType": "list", "comparer": "exact", "stated": "always" },
    { "kind": "index.unique", "label": "unique", "valueType": "bool", "comparer": "exact", "stated": "always" },
    { "kind": "index.filter", "label": "filter", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "index.name", "label": "index name", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "relationship.foreignKey", "label": "foreign key", "valueType": "list", "comparer": "list", "stated": "whenSet" },
    { "kind": "relationship.multiplicity", "label": "multiplicity", "valueType": "text", "comparer": "exact", "stated": "always" },
    { "kind": "column.textType", "label": "text type", "valueType": "text", "comparer": "ignoreCase", "stated": "always" },
    { "kind": "table.kind", "label": "table or view", "valueType": "text", "comparer": "exact", "stated": "always" },
    { "kind": "column.name", "label": "column", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "column.type", "label": "column type", "valueType": "text", "comparer": "storeType", "stated": "whenSet" },
    { "kind": "column.maxLength", "label": "max length", "valueType": "number", "comparer": "number", "stated": "whenSet" },
    { "kind": "column.precision", "label": "precision", "valueType": "number", "comparer": "number", "stated": "whenSet" },
    { "kind": "column.scale", "label": "scale", "valueType": "number", "comparer": "number", "stated": "whenSet" },
    { "kind": "column.default", "label": "default", "valueType": "text", "comparer": "literal", "stated": "whenSet" },
    { "kind": "column.defaultSql", "label": "SQL expression default", "valueType": "bool", "comparer": "exact", "stated": "whenSet" },
    { "kind": "key.generated", "label": "key generation", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "column.mapped", "label": "mapped", "valueType": "bool", "comparer": "exact", "stated": "always" },
    { "kind": "column.owned", "label": "owned", "valueType": "bool", "comparer": "exact", "stated": "always" },
    { "kind": "column.enumStorage", "label": "enum storage", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "column.version", "label": "concurrency token", "valueType": "bool", "comparer": "exact", "stated": "always" },
    { "kind": "column.backingField", "label": "backing field", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "column.hilo", "label": "hi-lo sequence", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "relationship.joinColumn", "label": "join column", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "relationship.onDelete", "label": "on delete", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "relationship.navigable", "label": "navigable", "valueType": "bool", "comparer": "exact", "stated": "always" },
    { "kind": "relationship.reference", "label": "navigation", "valueType": "presence", "comparer": "presence", "stated": "always", "existence": true }
  ],
  "vocabulary": {
    "Domain": {
      "designer": "Domain",
      "entries": [
        { "kind": "entity.persisted", "for": { "element": "Class", "where": "hasStereotype('Table') || hasStereotype('View')" }, "value": "'true'", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "source": "the class's Table or View stereotype" },
        { "kind": "table.name", "for": { "element": "Class", "where": "hasStereotype('Table')" }, "value": "stereotype('Table').Name", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Table Name" },
        { "kind": "table.schema", "for": { "element": "Class", "where": "hasStereotype('Table')" }, "value": "stereotype('Table').Schema ?? enclosing('Schema').Name", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Table Schema, else the Schema stereotype on its folder or package" },
        { "kind": "key", "for": { "element": "Class", "where": "count(where(inherited('Attribute'), hasStereotype('Primary Key'))) != '0' && (!abstract || hasStereotype('Table') || hasStereotype('View'))" }, "value": "join(map(where(inherited('Attribute'), hasStereotype('Primary Key')), name), ', ')", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Primary Key attributes, its own or a base class's" },
        { "kind": "key", "for": { "element": "Class", "where": "count(where(inherited('Attribute'), hasStereotype('Primary Key'))) == '0' && (hasStereotype('Table') || hasStereotype('View'))" }, "value": "'none'", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Primary Key attributes, its own or a base class's, of which it has none" },
        { "kind": "table.name", "for": { "element": "Class", "where": "hasStereotype('View')" }, "value": "stereotype('View').Name", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's View Name" },
        { "kind": "table.schema", "for": { "element": "Class", "where": "hasStereotype('View')" }, "value": "stereotype('View').Schema ?? enclosing('Schema').Name", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's View Schema, else the Schema stereotype on its folder or package" },
        { "kind": "table.kind", "for": { "element": "Class", "where": "hasStereotype('View')" }, "value": "'View'", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's View stereotype" },
        { "kind": "table.kind", "for": { "element": "Class", "where": "hasStereotype('Table') && !hasStereotype('View')" }, "value": "'Table'", "bindings": { "Entity": "name" }, "dependsOn": "type.exists", "waitsOn": ["entity.persisted"], "source": "the class's Table stereotype" },
        { "kind": "column.name", "for": { "element": "Attribute", "where": "hasStereotype('Column')" }, "value": "stereotype('Column').Name", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped"], "source": "the attribute's Column Name" },
        { "kind": "column.type", "for": { "element": "Attribute", "where": "hasStereotype('Column')" }, "value": "stereotype('Column').Type", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped"], "source": "the attribute's Column Type" },
        { "kind": "index.columns", "for": { "element": "Index" }, "value": "join(map(children('Index Column'), name), ', ')", "bindings": { "Entity": "parent.name", "Index": "name" }, "dependsOn": "parent:type.exists", "waitsOn": ["parent:entity.persisted"], "source": "the index's columns" },
        { "kind": "index.unique", "for": { "element": "Index" }, "value": "stereotype('Settings').Unique", "bindings": { "Entity": "parent.name", "Index": "name" }, "dependsOn": "parent:type.exists", "waitsOn": ["parent:entity.persisted"], "source": "the index's Unique" },
        { "kind": "index.filter", "for": { "element": "Index", "where": "stereotype('Settings').Filter == 'Custom'" }, "value": "stereotype('Settings')['Filter Custom Value']", "bindings": { "Entity": "parent.name", "Index": "name" }, "dependsOn": "parent:type.exists", "waitsOn": ["parent:entity.persisted"], "source": "the index's Filter Custom Value" },
        { "kind": "index.name", "for": { "element": "Index", "where": "stereotype('Settings')['Use Default Name'] == false" }, "value": "name", "bindings": { "Entity": "parent.name", "Index": "name" }, "dependsOn": "parent:type.exists", "waitsOn": ["parent:entity.persisted", "index.columns"], "source": "the index's name, with Use Default Name off" },
        { "kind": "column.textType", "for": { "element": "Attribute", "where": "type.name == 'string' && (hasStereotype('Text Constraints') || parent.hasStereotype('Table') && !exists(stereotype('Column').Type))" }, "value": "stereotype('Text Constraints')['SQL Data Type'] ?? 'DEFAULT'", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped"], "source": "the attribute's Text Constraints SQL Data Type, DEFAULT without one" },
        { "kind": "column.maxLength", "for": { "element": "Attribute", "applies": "type.name == 'string'", "where": "hasStereotype('Text Constraints')" }, "value": "stereotype('Text Constraints').MaxLength", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped"], "source": "the attribute's Text Constraints MaxLength" },
        { "kind": "column.precision", "for": { "element": "Attribute", "applies": "type.name == 'decimal'", "where": "hasStereotype('Decimal Constraints')" }, "value": "stereotype('Decimal Constraints').Precision", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped"], "source": "the attribute's Decimal Constraints Precision" },
        { "kind": "column.scale", "for": { "element": "Attribute", "applies": "type.name == 'decimal'", "where": "hasStereotype('Decimal Constraints')" }, "value": "stereotype('Decimal Constraints').Scale", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped"], "source": "the attribute's Decimal Constraints Scale" },
        { "kind": "column.default", "for": { "element": "Attribute", "where": "hasStereotype('Default Constraint')" }, "value": "stereotype('Default Constraint').Value", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped"], "source": "the attribute's Default Constraint Value" },
        { "kind": "column.defaultSql", "for": { "element": "Attribute", "where": "hasStereotype('Default Constraint') && stereotype('Default Constraint')['Treat as SQL Expression'] == true" }, "value": "'true'", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped", "column.default"], "source": "the attribute's Default Constraint Treat as SQL Expression" },
        { "kind": "key.generated", "for": { "element": "Attribute", "applies": "hasStereotype('Primary Key')", "where": "stereotype('Primary Key')['Data source'] != 'Default'" }, "value": "stereotype('Primary Key')['Data source']", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted"], "source": "the attribute's Primary Key Data source" },
        { "kind": "column.mapped", "for": { "element": "Attribute", "where": "parent.hasStereotype('Table') || parent.hasStereotype('View')" }, "value": "'true'", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.backingField"], "source": "the attribute being one of a class with Table or View, which the model persists" },
        { "kind": "column.owned", "for": { "element": "Attribute", "where": "(parent.hasStereotype('Table') || parent.hasStereotype('View')) && type.element.specialization == 'Value Object'" }, "value": "'true'", "bindings": { "Entity": "parent.name", "Attribute": "name" }, "dependsOn": "member.exists", "waitsOn": ["parent:entity.persisted", "column.mapped"], "source": "the attribute's Value Object type" }
      ],
      "nonClaims": [
        { "for": { "stereotype": "Relational Database" }, "reason": "Marks the package as stored in a relational database; what that states, its tables, keys, columns and indexes, is checked." }
      ]
    }
  }
}

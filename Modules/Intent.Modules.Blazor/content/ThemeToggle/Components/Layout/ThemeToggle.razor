@using Microsoft.AspNetCore.Components.Web

<span class="@Class"
      onclick="themeStorage.toggle()"
      style="@Style">
    <button class="btn-icon theme-toggle-button"
            type="button"
            title="Toggle theme"
            aria-label="Toggle light/dark mode"
            @onclick="OnToggle">
        <svg class="theme-toggle-to-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="theme-toggle-to-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
    </button>
</span>

<style>
    .theme-toggle-to-dark { display: none; }
    :root[data-theme="light"] .theme-toggle-to-light { display: none; }
    :root[data-theme="light"] .theme-toggle-to-dark { display: block; }
</style>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string Style { get; set; } = "cursor:pointer";

    [Parameter]
    public EventCallback<MouseEventArgs> OnToggle { get; set; }
}

{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Security.Bearer": {
        "Authority": "https://localhost:{sts_port}",
        "Audience": "api"
    },
    "CqrsSettings": {
        "LogRequestPayload": true
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext"
        ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
                    "restrictedToMinimumLevel": "Information"
                }
            }
        ]
    },
    "ConnectionStrings": {
        "DefaultConnection": "Server=.;Initial Catalog=Wolverine.Subscribe.RabbitMQ;Integrated Security=true;MultipleActiveResultSets=True;Encrypt=False"
    },
    "Wolverine": {
        "RabbitMq": {
            "Host": "localhost",
            "Port": 5672,
            "VirtualHost": "/",
            "Username": "guest",
            "Password": "guest"
        },
        "ErrorHandling": {
            "RetryWithCooldown": {
                "Delays": [
                    "00:00:01",
                    "00:00:05",
                    "00:00:15"
                ]
            }
        }
    }
}

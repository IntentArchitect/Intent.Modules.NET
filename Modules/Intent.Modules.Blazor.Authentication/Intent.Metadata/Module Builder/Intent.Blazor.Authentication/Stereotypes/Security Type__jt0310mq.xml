<?xml version="1.0" encoding="utf-8"?>
<stereotypeDefinition id="472c2df3-e807-4cf6-89b1-8213cd485c26" version="3.1.0">
  <comment>Configures which security implementation the modelled UI pages/policies should target.</comment>
  <name>Security Type</name>
  <targetMode>of-type</targetMode>
  <targetTypes>
    <type id="0888156b-6645-49b6-8180-77095e20783c">Security Configuration</type>
  </targetTypes>
  <targetReferenceTypes />
  <applyMode>always</applyMode>
  <icon type="UrlImagePath" source="data:image/png;base64," />
  <displayIcon>false</displayIcon>
  <displayIconFunction>return false;</displayIconFunction>
  <displayAsAnnotation>false</displayAsAnnotation>
  <displayAsText>true</displayAsText>
  <autoAdd>false</autoAdd>
  <allowMultipleApplies>false</allowMultipleApplies>
  <parentFolderId>b9d38f7c-7a8d-4007-b33d-7f386ccf119a</parentFolderId>
  <order>0</order>
  <packageId>b9d38f7c-7a8d-4007-b33d-7f386ccf119a</packageId>
  <packageName>Intent.Blazor.Authentication</packageName>
  <onAppliedScript>element.setMetadata("authentication", "ASP.NET Core Identity");</onAppliedScript>
  <onChangedScript>const stereotype = element.getStereotype("472c2df3-e807-4cf6-89b1-8213cd485c26");
const securityType = stereotype.getProperty("Authentication").getValue();

try {
    await dialogService.confirm("Security Type changed to \"" + securityType + "\". Once confirmed, this is where the relevant pages will be modelled.");
    element.setMetadata("authentication", securityType);
} catch {
    stereotype.getProperty("Authentication").setValue(element.getMetadata("authentication"));
}</onChangedScript>
  <properties>
    <property id="f01f034a-a2d7-4ef6-b102-050df72ec423">
      <name>Authentication</name>
      <type>string</type>
      <controlType>select</controlType>
      <optionsSource>options</optionsSource>
      <defaultValue>ASP.NET Core Identity</defaultValue>
      <valueOptions>
        <option>ASP.NET Core Identity</option>
        <option>JWT</option>
        <option>OIDC</option>
      </valueOptions>
    </property>
  </properties>
</stereotypeDefinition>
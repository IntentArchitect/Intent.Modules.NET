  <moduleSettings>
    <group id="489a67db-31b2-4d51-96d7-52637c3795be" title="Blazor Settings" externalReference="489a67db-31b2-4d51-96d7-52637c3795be" type="application-settings">
      <settings>
        <setting id="4c4c903b-6fbb-4a6b-b1f7-98a180f010f2" title="Use Code Behind Files for Components" type="switch">
          <hint>Use [code-behind](https://learn.microsoft.com/aspnet/core/blazor/components#partial-class-support) files for Razor components.</hint>
          <defaultValue>true</defaultValue>
        </setting>
        <setting id="3e3d24f8-ad29-44d6-b7e5-e76a5af2a7fa" title="Render Mode" type="select">
          <hint>Determines how the page content is rendered at runtime.</hint>
          <defaultValue>interactive-server</defaultValue>
          <options>
            <option value="interactive-server" description="Interactive Server" />
            <option value="interactive-web-assembly" description="Interactive Web Assembly" />
            <option value="interactive-auto" description="Interactive Auto" />
          </options>
        </setting>
        <setting id="d851b4d1-b230-461f-9873-80d6857fa175" title="Prerendering" type="switch">
          <hint>Enable prerendering for Interactive Server mode.</hint>
          <defaultValue>false</defaultValue>
          <isActiveFunction>return getProperty("Render Mode").value != "interactive-web-assembly";</isActiveFunction>
        </setting>
        <setting id="fa401099-f333-4702-a261-4d66239dde29" title="Enable Theme Toggle" type="switch">
          <hint>Show a dark/light mode toggle in the navigation bar</hint>
          <defaultValue>true</defaultValue>
        </setting>
      </settings>
    </group>
  </moduleSettings>

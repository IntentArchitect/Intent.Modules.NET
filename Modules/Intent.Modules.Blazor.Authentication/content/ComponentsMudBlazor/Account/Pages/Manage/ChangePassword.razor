@page "/Account/Manage/ChangePassword"

@using Microsoft.AspNetCore.Identity

@inject UserManager<<#= IdentityClass #>> UserManager
@inject SignInManager<<#= IdentityClass #>> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Change password</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Change password</MudText>
<StatusMessage Message="@message" />

<MudCard Class="auth-form-card">
    <MudCardContent>
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <MudTextField Label="Old password" For="@(() => Input.OldPassword)" @bind-Value="Input.OldPassword"
                          InputType="InputType.Password" Required="true" RequiredError="Old password is required"
                          AutoComplete="current-password" Class="mb-3" />
            <MudTextField Label="New password" For="@(() => Input.NewPassword)" @bind-Value="Input.NewPassword"
                          InputType="InputType.Password" Required="true" RequiredError="New password is required"
                          AutoComplete="new-password" Class="mb-3" />
            <MudTextField Label="Confirm password" For="@(() => Input.ConfirmPassword)" @bind-Value="Input.ConfirmPassword"
                          InputType="InputType.Password" AutoComplete="new-password" Class="mb-3" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">Update password</MudButton>
        </EditForm>
    </MudCardContent>
</MudCard>

@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid password reset</PageTitle>

<MudPaper Class="pa-4 mb-4 ux-gradient-primary" Elevation="0">
    <MudText Typo="Typo.h4" Class="text-white font-weight-bold mb-2">
        <MudIcon Icon="@Icons.Material.Filled.LinkOff" Class="mr-2" />
        Invalid password reset
    </MudText>
    <MudText Typo="Typo.body1" Class="text-white opacity-90">
        The password reset request could not be validated.
    </MudText>
</MudPaper>

<MudCard Class="ux-fade-in-up auth-form-shell" Style="animation-delay: 0.1s" Outlined="true">
    <MudCardContent>
        <MudText Typo="Typo.h5" Class="mb-3">Invalid reset link</MudText>
        <MudText Typo="Typo.body1">The password reset link is invalid.</MudText>
    </MudCardContent>
</MudCard>

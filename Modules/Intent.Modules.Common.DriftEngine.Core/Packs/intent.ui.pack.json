        { "kind": "intent.invokes", "for": { "association": "Call Service Operation Action", "where": "source.element.specialization != 'Proxy Operation'" }, "value": "self", "bindings": { "Component": "if(source.element.specialization == 'Component Operation', source.element.parent.name, source.element.name)", "Invoked": "target.element.name" }, "own": ["Component", "Invoked"], "source": "its Call Service Operation Action" },

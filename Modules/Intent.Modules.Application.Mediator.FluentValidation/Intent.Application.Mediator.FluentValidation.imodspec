<?xml version="1.0" encoding="utf-8"?>
<package>
  <id>Intent.Application.Mediator.FluentValidation</id>
  <version>1.0.0-pre.1</version>
  <supportedClientVersions>[5.1.0-a,6.0.0)</supportedClientVersions>
  <summary>FluentValidation support for Mediator command and query handlers.</summary>
  <description>FluentValidation support for Mediator command and query handlers.</description>
  <authors>Intent Architect</authors>
  <iconUrl>data:image/svg+xml;base64,</iconUrl>
  <templates>
    <template id="Intent.Application.Mediator.FluentValidation.BypassValidationInterface" externalReference="cc9f61ed-a5c3-4661-a00c-342db5c3f480">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Application.Common.BypassValidationInterface</role>
      <location>Common/Interfaces</location>
      <severity>medium</severity>
      <classifications>Validation</classifications>
    </template>
    <template id="Intent.Application.Mediator.FluentValidation.CommandValidator" externalReference="a288ffaf-91c1-478e-9b9a-a227cc71f370">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Application.Validation.Command</role>
      <location></location>
      <severity>medium</severity>
      <classifications>Validation</classifications>
    </template>
    <template id="Intent.Application.Mediator.FluentValidation.QueryValidator" externalReference="6c2ba0d0-cb18-4bbb-88a4-344b8737362c">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Application.Validation.Query</role>
      <location></location>
      <severity>medium</severity>
      <classifications>Validation</classifications>
    </template>
    <template id="Intent.Application.Mediator.FluentValidation.ValidationBehaviour" externalReference="82fad179-3279-432a-9c90-c98a8223641b">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Infrastructure.Mediator.Dispatch.Behaviours.ValidationBehaviour</role>
      <location>Dispatch/Behaviours</location>
      <severity>high</severity>
      <classifications>Validation,Request Pipeline</classifications>
    </template>
  </templates>
  <decorators></decorators>
  <factoryExtensions>
    <factoryExtension id="Intent.Application.Mediator.FluentValidation.AISkillsExtension" externalReference="e5134267-ed75-4e2a-85f9-b359d46afef7" />
    <factoryExtension id="Intent.Application.Mediator.FluentValidation.UnhandledExceptionBehaviourExtension" externalReference="2f9fa230-9b10-4eea-b0d8-3a231b17c9aa" />
  </factoryExtensions>
  <moduleSettings></moduleSettings>
  <dependencies>
    <dependency id="Intent.Application.FluentValidation" version="3.12.2" />
    <dependency id="Intent.Application.Mediator" version="1.0.0-pre.0" />
    <dependency id="Intent.Common" version="3.11.2" />
    <dependency id="Intent.Common.CSharp" version="3.10.10" />
    <dependency id="Intent.Common.Types" version="3.4.0" />
    <dependency id="Intent.Modelers.Domain" version="3.13.2" />
    <dependency id="Intent.Modelers.Services" version="4.0.16" />
    <dependency id="Intent.Modelers.Services.CQRS" version="6.0.8" />
    <dependency id="Intent.OutputManager.RoslynWeaver" version="4.5.1" />
  </dependencies>
  <files>
    <file src="$outDir$/$id$.dll" />
    <file src="$outDir$/$id$.pdb" />
  </files>
  <tags>mediator fluentvalidation validation cqrs dotnet</tags>
  <moduleSettingsExtensions />

      <requiredPackages />
      <contextMenuOptions>
        <runScript type="run-script">
          <text>Set Authentication</text>
          <icon type="UrlImagePath" source="data:image/png;base64," />
          <subMenuOptions>
            <runScript type="run-script">
              <text>None</text>
              <icon type="UrlImagePath" source="data:image/png;base64," />
              <isOptionVisibleFunction>const st = element.getStereotype("472c2df3-e807-4cf6-89b1-8213cd485c26");
return !st || st.getProperty("Authentication").getValue() !== "None";</isOptionVisibleFunction>
              <script>const stereotype = element.ensureStereotype("472c2df3-e807-4cf6-89b1-8213cd485c26");
stereotype.getProperty("Authentication").setValue("None");</script>
            </runScript>
            <runScript type="run-script">

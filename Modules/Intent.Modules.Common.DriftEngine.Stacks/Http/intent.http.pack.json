{
  "id": "intent.http",
  "version": "1.0.0",
  "description": "HTTP APIs: routes, verbs, parameter sources and security, from the Services designer's HTTP and security stereotypes. Framework extensions read them from code.",
  "requires": [{ "id": "intent.services", "version": "^1.0.0" }],
  "designers": ["Services"],
  "kinds": [
    { "kind": "service.route", "label": "route", "valueType": "route", "comparer": "route", "stated": "whenSet" },
    { "kind": "operation.verb", "label": "verb", "valueType": "text", "comparer": "ignoreCase", "stated": "always" },
    { "kind": "operation.route", "label": "route", "valueType": "route", "comparer": "route", "stated": "whenSet" },
    { "kind": "parameter.source", "label": "source", "valueType": "text", "comparer": "exact", "stated": "whenSet" },
    { "kind": "service.secured", "label": "secured", "valueType": "bool", "comparer": "exact", "stated": "whenSet" },
    { "kind": "service.roles", "label": "roles", "valueType": "set", "comparer": "set", "stated": "whenSet" },
    { "kind": "operation.secured", "label": "secured", "valueType": "bool", "comparer": "exact", "stated": "whenSet" },
    { "kind": "operation.roles", "label": "roles", "valueType": "set", "comparer": "set", "stated": "whenSet" },
    { "kind": "operation.anonymous", "label": "anonymous", "valueType": "bool", "comparer": "exact", "stated": "whenSet" }
  ],
  "vocabulary": {
    "Services": {
      "designer": "Services",
      "entries": [
        { "kind": "service.route", "for": { "element": "Service", "where": "hasStereotype('Http Service Settings')" }, "value": "stereotype('Http Service Settings').Route", "dependsOn": "type.exists", "source": "the service's Http Service Settings Route" },
        { "kind": "operation.verb", "for": { "element": "Operation", "where": "hasStereotype('Http Settings')" }, "value": "stereotype('Http Settings').Verb", "dependsOn": "member.exists", "source": "the operation's Http Settings Verb" },
        { "kind": "operation.route", "for": { "element": "Operation", "where": "hasStereotype('Http Settings')" }, "value": "stereotype('Http Settings').Route", "dependsOn": "member.exists", "source": "the operation's Http Settings Route" },
        { "kind": "parameter.source", "for": { "element": "Parameter", "where": "hasStereotype('Parameter Settings') && stereotype('Parameter Settings').Source != 'Default'" }, "value": "stereotype('Parameter Settings').Source", "dependsOn": "parent:member.exists", "source": "the parameter's Parameter Settings Source" },
        { "kind": "service.secured", "for": { "element": "Service", "where": "hasStereotype('Secured')" }, "value": "hasStereotype('Secured')", "dependsOn": "type.exists", "source": "the service's Secured" },
        { "kind": "service.roles", "for": { "element": "Service", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Roles", "dependsOn": "type.exists", "source": "the service's Secured Roles" },
        { "kind": "operation.secured", "for": { "element": "Operation", "where": "hasStereotype('Secured')" }, "value": "hasStereotype('Secured')", "dependsOn": "member.exists", "source": "the operation's Secured" },
        { "kind": "operation.roles", "for": { "element": "Operation", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Roles", "dependsOn": "member.exists", "source": "the operation's Secured Roles" },
        { "kind": "operation.anonymous", "for": { "element": "Operation", "where": "hasStereotype('Unsecured')" }, "value": "hasStereotype('Unsecured')", "dependsOn": "member.exists", "source": "the operation's Unsecured" }
      ]
    }
  }
}

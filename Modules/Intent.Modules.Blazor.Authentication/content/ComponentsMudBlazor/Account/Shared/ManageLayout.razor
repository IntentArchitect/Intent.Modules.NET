@inherits LayoutComponentBase
@using <#= Namespace #>Components.Layout

@* Self-contained static-SSR shell for the Identity manage area — it does NOT nest MainLayout, so
   the interactive shell stays branch-free. The chrome is entirely circuit-free (the manage pages
   run as static SSR with no Blazor circuit): a vanilla-JS hamburger + an overlay <aside> drawer,
   a native <details> user menu, and a cookie-derived Mud theme — the same idioms AccountLayout
   uses. The look matches MainLayout via the shared NavLinks / AppUserMenu / ThemeToggle atoms. *@

<MudThemeProvider IsDarkMode="@IsDarkTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <span class="ux-nav-toggle" style="cursor: pointer;" onclick="navDrawer.toggle()">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start" />
        </span>
        <MudButton Href="/"
                   Class="my-2 mr-2"
                   Color="Color.Inherit">
            <MudText Typo="Typo.h5">Application</MudText>
        </MudButton>
        <MudSpacer />
        <ThemeToggle />
        <AppUserMenu />
    </MudAppBar>
    <aside class="ux-account-nav-drawer">
        <NavLinks Items="AppNav.Items" />
    </aside>
    <MudMainContent Class="mt-16 pa-4 manage-layout-content">
        @if (HttpContext is null)
        {
            <p>Loading...</p>
        }
        else
        {
            <MudText Typo="Typo.h4" Class="mb-3">Manage your account</MudText>

            <MudGrid>
                <MudItem xs="12" md="3">
                    <ManageNavMenu />
                </MudItem>
                <MudItem xs="12" md="9">
                    @Body
                </MudItem>
            </MudGrid>
        }
    </MudMainContent>
</MudLayout>

        { "kind": "property.query", "for": { "element": "Property", "where": "parent.specialization == 'Component' || parent.specialization == 'Page' || parent.specialization == 'Dialog'" }, "value": "hasStereotype('Query Parameter') || hasStereotype('[Query Parameter]')", "dependsOn": "member.exists", "source": "the property's [Query Parameter] stereotype" },
        { "kind": "property.route", "for": { "element": "Property", "where": "parent.specialization == 'Component' || parent.specialization == 'Page' || parent.specialization == 'Dialog'" }, "value": "hasStereotype('Route Parameter') || hasStereotype('[Route Parameter]')", "dependsOn": "member.exists", "source": "the property's [Route Parameter] stereotype" },
        { "kind": "property.bindable", "for": { "element": "Property", "where": "parent.specialization == 'Component' || parent.specialization == 'Page' || parent.specialization == 'Dialog'" }, "value": "hasStereotype('Bindable') || hasStereotype('[Bindable]')", "dependsOn": "member.exists", "source": "the property's [Bindable] stereotype" },

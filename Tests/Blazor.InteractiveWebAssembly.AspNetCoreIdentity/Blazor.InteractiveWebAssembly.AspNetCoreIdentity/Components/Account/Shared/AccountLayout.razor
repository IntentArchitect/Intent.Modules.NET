@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

@using Blazor.InteractiveWebAssembly.AspNetCoreIdentity.Client.Layout

<MudThemeProvider IsDarkMode="@IsDarkTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AppBrand Class="account-brand" />
<ThemeToggle Class="account-theme-toggle" />

<MudLayout>
    <MudMainContent Class="pa-4">
        <div class="account-layout-content">
            @if (HttpContext is null)
            {
                <p>Loading...</p>
            }
            else
            {
                @Body
            }
        </div>
    </MudMainContent>
</MudLayout>
@layout Blazor.InteractiveWebAssembly.AspNetCoreIdentity.Client.Layout.MainLayout

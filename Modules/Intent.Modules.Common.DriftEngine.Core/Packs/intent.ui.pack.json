        { "kind": "page.route", "for": { "element": "Component", "where": "hasStereotype('Page')" }, "value": "split(stereotype('Page').Route, ',')", "bindings": { "Component": "name", "Page": "name", "Route": "trimStart(stereotype('Page').Route, '/')" }, "own": ["Component", "Page", "Route"], "dependsOn": "type.exists", "source": "the Page stereotype's Route" },
        { "kind": "page.title", "for": { "element": "Component", "where": "hasStereotype('Page')" }, "value": "stereotype('Page').Title", "bindings": { "Component": "name" }, "own": ["Component"], "dependsOn": "type.exists", "source": "the Page stereotype's Title" },

<?xml version="1.0" encoding="utf-8"?>
<package>
  <id>Intent.Infrastructure.Constants</id>
  <version>1.0.1-pre.0</version>
  <supportedClientVersions>[4.4.0-a,6.0.0)</supportedClientVersions>
  <summary>Generates a Constants class with extension points for runtime constant registration</summary>
  <description>This module provides a Constants class template that can be extended by other modules to register constants (like connection string names) at software factory runtime. The first use case is Entity Framework connection string constants.</description>
  <authors>Intent Architect</authors>
  <iconUrl>data:image/svg+xml;base64,</iconUrl>
  <templates>
    <template id="Intent.Infrastructure.Constants.ConstantsTemplate" externalReference="835e121a-d120-457c-b1c7-750bfccadc5b">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Infrastructure.Constants</role>
      <location></location>
    </template>
  </templates>
  <decorators></decorators>
  <factoryExtensions />
  <moduleSettings></moduleSettings>
  <dependencies>
    <dependency id="Intent.Common" version="3.7.2" />
    <dependency id="Intent.Common.CSharp" version="3.8.0" />
    <dependency id="Intent.Common.Types" version="3.4.0" />
    <dependency id="Intent.OutputManager.RoslynWeaver" version="4.5.1" />
  </dependencies>
  <files>
    <file src="$outDir$/$id$.dll" />
    <file src="$outDir$/$id$.pdb" />
  </files>
  <tags>constants, infrastructure, entity-framework</tags>
  <releaseNotes>release-notes.md</releaseNotes>
  <moduleSettingsExtensions />
  <metadata />
  <migrations />
</package>
  <decorators></decorators>
  <factoryExtensions>
    <factoryExtension id="Intent.Eventing.Wolverine.WolverineEventingRegistrationExtension" externalReference="2a4017ae-c90e-458e-ab77-342d36a450c0" />
    <factoryExtension id="Intent.Eventing.Wolverine.WolverineFinbuckleConfiguratorExtension" externalReference="ef6ebd2c-9819-46a9-87c6-79bdedaffca9" />

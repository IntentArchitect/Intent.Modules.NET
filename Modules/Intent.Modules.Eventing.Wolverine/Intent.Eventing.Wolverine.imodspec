  <moduleSettings>
    <group id="a37422a7-64ad-446f-905b-75651043fe33" title="Wolverine Message Bus Settings" type="application-settings" externalReference="a37422a7-64ad-446f-905b-75651043fe33">
      <settings>
        <setting id="dc046cdc-e50f-4822-86f5-8372b2a6e2b0" title="Transport" type="select">
          <isRequired>true</isRequired>
          <hint>Local runs entirely in-process (no external broker); the other options require a real broker connection.</hint>
          <defaultValue>local</defaultValue>
          <options>
            <option value="local" description="Local" />
            <option value="rabbitmq" description="RabbitMQ" />
            <option value="azure-service-bus" description="Azure Service Bus" />
            <option value="amazon-sqs" description="Amazon SQS" />
          </options>
        </setting>
        <setting id="2c31038a-8056-4b04-a183-9da3b504cbbe" title="Transactional Outbox" type="select">
          <isRequired>true</isRequired>
          <hint>Durable storage is derived from the application's modelled Database Provider - this setting names no persistence technology.</hint>
          <defaultValue>none</defaultValue>
          <options>
            <option value="none" description="None" />
            <option value="durable" description="Durable" />
          </options>
        </setting>
        <setting id="d016cdb6-f1ec-49f2-82af-4d6be226532b" title="Error Handling Policy" type="select">
          <isRequired>true</isRequired>
          <defaultValue>retry-with-cooldown</defaultValue>
          <options>
            <option value="none" description="None" />
            <option value="retry" description="Retry" />
            <option value="retry-with-cooldown" description="Retry with cooldown" />
            <option value="schedule-retry" description="Schedule retry" />
          </options>
        </setting>
      </settings>
    </group>
  </moduleSettings>

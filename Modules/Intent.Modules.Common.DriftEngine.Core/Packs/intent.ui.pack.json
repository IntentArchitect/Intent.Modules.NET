        { "kind": "proxy.route", "for": { "association": "Call Service Operation Action", "where": "source.element.specialization == 'Proxy Operation'" }, "value": "if(exists(target.element.parent.stereotype('Http Service Settings').Route), if(exists(target.element.stereotype('Http Settings').Route), replace(target.element.parent.stereotype('Http Service Settings').Route, '[controller]', trimEnd(target.element.parent.name, 'Service')) + '/' + target.element.stereotype('Http Settings').Route, replace(target.element.parent.stereotype('Http Service Settings').Route, '[controller]', trimEnd(target.element.parent.name, 'Service'))), target.element.stereotype('Http Settings').Route)", "bindings": { "Proxy": "source.element.parent.name", "Operation": "source.element.name" }, "own": ["Operation"], "source": "the called operation's Http Service Settings and Http Settings Routes" }
      ],
      "nonClaims": [
        { "for": { "element": "Folder" }, "reason": "Folders organise the model; what is in them is checked." },
        { "for": { "element": "Diagram" }, "reason": "A diagram is a view of the model, not a statement about the code." },
        { "for": { "element": "Comment" }, "reason": "Documentation." },
        { "for": { "element": "Type-Definition" }, "reason": "Names a type from outside the model, such as a library's, for members to use; every member typed by it is checked." },
        { "for": { "stereotype": "Folder Options" }, "reason": "How the designer shows a folder; folders organise the model." },
        { "for": { "stereotype": "Composable" }, "reason": "The trait the designer gives a component that isn't a page; component.kind checks what the component is." },
        { "for": { "stereotype": "Arrangement" }, "reason": "Where a region sits on the diagram; nothing in the code states it." }
      ]
    }
  },
  "conventions": {
    "User Interface": {
      "designer": "User Interface",
      "types": {
        "Page": { "typeKinds": ["component", "class"], "states": ["property", "method"] },
        "Dialog": { "typeKinds": ["component", "class"], "states": ["property", "method", "event"] },
        "Component": { "typeKinds": ["component", "class"], "states": ["property", "method", "event"] },
        "Layout": { "typeKinds": ["component", "class"], "states": ["property", "method"] },
        "Store": { "typeKinds": ["module", "class", "object"], "states": ["property", "method"] },
        "UI Service": { "typeKinds": ["module", "class", "object", "interface"], "states": ["method"] },
        "Utility": { "typeKinds": ["module", "class", "object"], "states": ["method"] },
        "Behaviour": { "typeKinds": ["module", "class", "object"], "states": ["method"] },
        "Proxy": { "typeKinds": ["object", "class", "interface", "module"], "states": ["method"] },
        "Contract": { "typeKinds": ["interface", "typeAlias", "class", "record", "struct"], "states": ["property", "field"] },

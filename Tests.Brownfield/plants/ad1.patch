+    [Theory]
+    [InlineData(1.0, 99911)]
+    [InlineData(2.0, 99912)]
+    public async Task DiscontinuedCatalogItemIsHiddenFromItemLists(double version, int id)
+    {
+        using var httpClient = CreateHttpClient(new ApiVersion(version));
+        var cancellationToken = TestContext.Current.CancellationToken;
+        var name = $"Discontinue test {id}";
+        var listUri = version switch
+        {
+            1.0 => $"api/catalog/items/by/{Uri.EscapeDataString(name)}?PageSize=5&PageIndex=0",
+            2.0 => $"api/catalog/items?name={Uri.EscapeDataString(name)}&PageSize=5&PageIndex=0",
+            _ => throw new ArgumentOutOfRangeException(nameof(version), version, null)
+        };
+
+        var createResponse = await httpClient.PostAsJsonAsync(
+            "/api/catalog/items",
+            new CatalogItem(name) { Id = id, CatalogTypeId = 1, CatalogBrandId = 1 },
+            cancellationToken);
+        createResponse.EnsureSuccessStatusCode();
+
+        try
+        {
+            var listed = await httpClient.GetFromJsonAsync<PaginatedItems<CatalogItem>>(listUri, _jsonSerializerOptions, cancellationToken);
+            Assert.Equal(1, listed!.Count);
+            Assert.False(listed.Data.Single().IsDiscontinued);
+
+            var discontinueResponse = await httpClient.PutAsync($"/api/catalog/items/{id}/discontinue", null, cancellationToken);
+            Assert.Equal(HttpStatusCode.NoContent, discontinueResponse.StatusCode);
+
+            listed = await httpClient.GetFromJsonAsync<PaginatedItems<CatalogItem>>(listUri, _jsonSerializerOptions, cancellationToken);
+            Assert.Equal(0, listed!.Count);
+            Assert.Empty(listed.Data);
+
+            // Discontinued items are still retrievable by id
+            var item = await httpClient.GetFromJsonAsync<CatalogItem>($"/api/catalog/items/{id}", _jsonSerializerOptions, cancellationToken);
+            Assert.True(item!.IsDiscontinued);
+
+            // Discontinuing again is a no-op
+            discontinueResponse = await httpClient.PutAsync($"/api/catalog/items/{id}/discontinue", null, cancellationToken);
+            Assert.Equal(HttpStatusCode.NoContent, discontinueResponse.StatusCode);
+        }
+        finally
+        {
+            await httpClient.DeleteAsync($"/api/catalog/items/{id}", cancellationToken);
+        }
+    }
+

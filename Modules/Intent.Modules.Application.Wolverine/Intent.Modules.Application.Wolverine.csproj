<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Version>1.1.0-pre.2</Version>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Intent.Modules.Common" Version="3.11.2" />
        <PackageReference Include="Intent.Modules.Common.CSharp" Version="3.10.10" />
        <PackageReference Include="Intent.Modules.Metadata.Security" Version="1.0.1" />
        <PackageReference Include="Intent.Modules.Modelers.Services" Version="4.0.15" />
        <PackageReference Include="Intent.Modules.Modelers.Services.CQRS" Version="6.0.7" />
        <PackageReference Include="Intent.Packager" Version="3.6.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Intent.RoslynWeaver.Attributes" Version="3.0.0" />
        <PackageReference Include="Intent.SoftwareFactory.SDK" Version="3.14.0" />
    </ItemGroup>

    <!-- Intent.Modules.Wolverine.Common is deliberately NOT a ProjectReference. This module needs
         Intent.Wolverine.Common installed (declared as an .imodspec <dependency>) so its factory
         extension seeds the shared UseWolverine lambda, but it references none of its types. A
         PrivateAssets="All" ProjectReference would bundle a second copy of that module's DLL
         alongside the one the module itself ships, and the loader binds to whichever loads first. -->
    <ItemGroup>
        <ProjectReference Include="..\Intent.Modules.Constants\Intent.Modules.Constants.csproj" PrivateAssets="All" />
    </ItemGroup>

    <Import Project="..\Intent.Modules.Security.Shared\Intent.Modules.Security.Shared.projitems" Label="Shared" />
</Project>

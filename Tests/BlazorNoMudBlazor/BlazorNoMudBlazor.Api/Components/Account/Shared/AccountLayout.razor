@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

@using BlazorNoMudBlazor.Api.Components.Layout

<AppBrand Class="account-brand" />
<ThemeToggle Class="account-theme-toggle" />

<main class="account-layout-main">
    <div class="account-layout-content">
        @if (HttpContext is null)
        {
            <p>Loading...</p>
        }
        else
        {
            @Body
        }
    </div>
</main>

{
  "id": "intent.ui",
  "version": "1.0.0",
  "description": "User Interface designer vocabulary: pages, dialogs, layouts, components, stores, services, utilities, behaviours, proxies, contracts and the links between them (2.0.0), and the 1.x designer's components, model definitions and service proxies",
  "requires": [{ "id": "intent.core", "version": "^1.0.0" }],
  "languages": ["csharp", "typescript"],
  "designers": ["User Interface"],
  "kinds": [
    { "kind": "component.kind", "label": "component kind", "valueType": "text", "comparer": "exact", "stated": "always", "existence": false },
    { "kind": "page.route", "label": "page route", "valueType": "set", "comparer": "subset", "itemComparer": "route", "stated": "whenSet", "existence": false },
    { "kind": "page.title", "label": "page title", "valueType": "text", "comparer": "contains", "stated": "whenSet", "existence": false },
    { "kind": "property.query", "label": "query parameter", "valueType": "bool", "comparer": "exact", "stated": "always", "existence": false },
    { "kind": "property.route", "label": "route parameter", "valueType": "bool", "comparer": "exact", "stated": "always", "existence": false },
    { "kind": "property.bindable", "label": "bindable", "valueType": "bool", "comparer": "exact", "stated": "always", "existence": false },
    { "kind": "intent.uses", "label": "uses", "valueType": "presence", "comparer": "presence", "stated": "always", "existence": true },
    { "kind": "intent.navigates", "label": "navigates", "valueType": "presence", "comparer": "presence", "stated": "always", "existence": true },
    { "kind": "intent.opens", "label": "opens", "valueType": "presence", "comparer": "presence", "stated": "always", "existence": true },
    { "kind": "intent.target", "label": "interaction target", "valueType": "type", "comparer": "type", "stated": "always", "existence": false },
    { "kind": "intent.invokes", "label": "invokes", "valueType": "presence", "comparer": "presence", "stated": "always", "existence": true },
    { "kind": "proxy.request", "label": "proxy request", "valueType": "presence", "comparer": "presence", "stated": "always", "existence": true },
    { "kind": "proxy.verb", "label": "proxy verb", "valueType": "text", "comparer": "exact", "stated": "always", "existence": false },
    { "kind": "proxy.route", "label": "proxy route", "valueType": "text", "comparer": "route", "stated": "always", "existence": false },
    { "kind": "proxy.version", "label": "proxy API version", "valueType": "text", "comparer": "version", "stated": "whenSet", "existence": false },
    { "kind": "proxy.header", "label": "proxy header", "valueType": "set", "comparer": "subset", "stated": "whenSet", "existence": false },
    { "kind": "proxy.rpc", "label": "RPC method", "valueType": "text", "comparer": "exact", "stated": "always", "existence": false },
    { "kind": "proxy.grpcService", "label": "gRPC service", "valueType": "text", "comparer": "exact", "stated": "always", "existence": false }
  ],

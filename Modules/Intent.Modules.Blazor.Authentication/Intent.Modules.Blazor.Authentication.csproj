<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Intent.Modules.Common" Version="3.11.1" />
    <PackageReference Include="Intent.Modules.Common.CSharp" Version="3.10.9-pre.0" />
    <PackageReference Include="Intent.Modules.Modelers.Domain" Version="3.13.0" />
    <PackageReference Include="Intent.Packager" Version="3.6.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Intent.RoslynWeaver.Attributes" Version="3.0.0" />
    <PackageReference Include="Intent.SoftwareFactory.SDK" Version="3.14.0-pre.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intent.Modules.Blazor\Intent.Modules.Blazor.csproj" />
  </ItemGroup>

  <!-- Files under content/ are templates emitted into generated apps, not part of this module's build. -->
  <ItemGroup>
    <Compile Remove="content\**\*.cs" />
    <None Include="content\**\*.cs" />
  </ItemGroup>

</Project>
@page "/Account/AccessDenied"

<PageTitle>Access denied</PageTitle>

<MudPaper Class="pa-4 mb-4 ux-gradient-primary" Elevation="0">
    <MudText Typo="Typo.h4" Class="text-white font-weight-bold mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Block" Class="mr-2" />
        Access denied
    </MudText>
    <MudText Typo="Typo.body1" Class="text-white opacity-90">
        You do not have permission to access this resource.
    </MudText>
</MudPaper>

<MudCard Class="ux-fade-in-up auth-form-shell" Style="animation-delay: 0.1s" Outlined="true">
    <MudCardContent>
        <MudText Typo="Typo.h5" Color="Color.Error" Class="mb-3">Access denied</MudText>
        <MudText Typo="Typo.body1">You do not have access to this resource.</MudText>
    </MudCardContent>
</MudCard>

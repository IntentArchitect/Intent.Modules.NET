{
  "note": "Minimal APIs (method-group handlers in static *Api classes) plus MediatR, IIntegrationEventHandler<T> and INotificationHandler<T> handlers across the eShop services. Migrations are left out of `files`.",
  "files": [
    "src/Ordering.API/**/*.cs",
    "src/Catalog.API/*.cs",
    "src/Catalog.API/Apis/*.cs",
    "src/Catalog.API/IntegrationEvents/**/*.cs",
    "src/Catalog.API/Model/*.cs",
    "src/Catalog.API/Services/*.cs",
    "src/Webhooks.API/*.cs",
    "src/Webhooks.API/Apis/*.cs",
    "src/Webhooks.API/IntegrationEvents/*.cs",
    "src/Webhooks.API/Model/*.cs",
    "src/Webhooks.API/Services/*.cs",
    "src/Basket.API/**/*.cs",
    "src/OrderProcessor/**/*.cs",
    "src/PaymentProcessor/**/*.cs",
    "src/WebApp/**/*.cs",
    "src/WebAppComponents/**/*.cs",
    "src/WebhookClient/**/*.cs"
  ],
  "facts": {
    "service.route": {
      "note": "Read from the class's single Map method: Catalog declares three groups (api, v1, v2) that share one prefix. A versioned group (HasApiVersion, read from the query string by Asp.Versioning's default reader) is modelled with the version as a query string: `api/catalog?api-version={version}`.",
      "find": "class:{Service} > method with \\.MapGroup\\(",
      "read": [
        {
          "match": "\\.MapGroup\\(\"/?([^\"]*)\"\\)\\.HasApiVersion\\(",
          "value": "$1?api-version={version}"
        },
        {
          "match": "\\.MapGroup\\(\"/?([^\"]*)\"\\)"
        },
        {
          "match": "\\.MapGroup\\((?!\")[^)]*\\)",
          "unreadable": true
        }
      ],
      "absent": "",
      "unstated": "no `MapGroup` in `{Service}`, so its endpoints' routes are their own"
    },
    "operation.verb": {
      "find": [
        "class:{Service} > statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",(?:\\w+\\.)*{Operation}\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\([^;]*?\\.WithName\\(\"{Operation}\"\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",[^;]*?[(,\\]]{Operation} \\w+[,)]"
      ],
      "read": [
        {
          "match": "\\.Map(Get|Post|Put|Delete|Patch)\\(",
          "case": "upper"
        }
      ]
    },
    "operation.route": {
      "find": [
        "class:{Service} > statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",(?:\\w+\\.)*{Operation}\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\([^;]*?\\.WithName\\(\"{Operation}\"\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",[^;]*?[(,\\]]{Operation} \\w+[,)]"
      ],
      "read": [
        {
          "in": "method",
          "match": "\\.MapGroup\\(\"/?([^\"]+)\"\\)(?:(?!\\.MapGroup\\().)*?\\.Map(?:Get|Post|Put|Delete|Patch)\\(\"/?([^\"]*)\",[^;]*?[(,\\]]{Operation} \\w+[,)]",
          "value": "$1/$2"
        },
        {
          "match": "\\.Map\\w+\\(\"/?([^\"]*)\""
        },
        {
          "match": "\\.Map\\w+\\((?!\")[^,]*,",
          "unreadable": true
        }
      ],
      "replace": [
        {
          "match": "/$",
          "with": ""
        }
      ]
    },
    "security": {
      "find": [
        "class:{Service} > statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",(?:\\w+\\.)*{Operation}\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\([^;]*?\\.WithName\\(\"{Operation}\"\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",[^;]*?[(,\\]]{Operation} \\w+[,)]"
      ],
      "read": [
        {
          "in": "statement",
          "match": "\\.AllowAnonymous\\(\\)",
          "value": "Unsecured"
        },
        {
          "in": "statement",
          "match": "\\.RequireAuthorization\\(",
          "value": "Secured"
        },
        {
          "part": "declaration",
          "match": "[\\[,]AllowAnonymous\\b",
          "value": "Unsecured"
        },
        {
          "part": "declaration",
          "match": "[\\[,]Authorize\\b",
          "value": "Secured"
        },
        {
          "match": "\\.MapGroup\\([^;]*?\\.AllowAnonymous\\(\\)(?:(?!\\.MapGroup\\().)*?\\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\"[^;]*?(?:[(,\\]](?:\\w+\\.)*{Operation}(?: \\w+)?[,)]|\\.WithName\\(\"{Operation}\"\\))",
          "value": "Unsecured"
        },
        {
          "match": "\\.MapGroup\\([^;]*?\\.RequireAuthorization\\((?:(?!\\.MapGroup\\().)*?\\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\"[^;]*?(?:[(,\\]](?:\\w+\\.)*{Operation}(?: \\w+)?[,)]|\\.WithName\\(\"{Operation}\"\\))",
          "value": "Secured"
        },
        {
          "match": "\\bMap{Service}(?:V\\d+)?\\(\\)\\.RequireAuthorization\\(",
          "value": "Secured",
          "note": "Program.cs secures the whole group a Map method returns: `orders.MapOrdersApiV1().RequireAuthorization();`"
        }
      ],
      "inherit": [
        "method",
        "class:{Service} > method:{Operation}",
        "statement with \\bMap{Service}(?:V\\d+)?\\(\\)"
      ],
      "default": "None",
      "unstated": "no `RequireAuthorization` or `AllowAnonymous` on the endpoint, its group or the Program.cs call that maps `{Service}`, and no `[Authorize]` on its handler"
    },
    "security.roles": {
      "find": [
        "class:{Service} > statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",(?:\\w+\\.)*{Operation}\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\([^;]*?\\.WithName\\(\"{Operation}\"\\)",
        "statement with \\.Map(?:Get|Post|Put|Delete|Patch)\\(\"[^\"]*\",[^;]*?[(,\\]]{Operation} \\w+[,)]"
      ],
      "read": [
        {
          "in": "statement",
          "match": "\\.RequireAuthorization\\(\\w+=>\\w+\\.RequireRole\\(((?:\"[^\"]*\",)*\"[^\"]*)\"\\)"

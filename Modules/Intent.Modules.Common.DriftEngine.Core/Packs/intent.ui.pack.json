        { "kind": "file.exists", "for": { "element": "Page", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "file.exists", "for": { "element": "Dialog", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "file.exists", "for": { "element": "Component", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "file.exists", "for": { "element": "Layout", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "file.exists", "for": { "element": "Store", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "file.exists", "for": { "element": "UI Service", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "file.exists", "for": { "element": "Utility", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "file.exists", "for": { "element": "Behaviour", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "file.exists", "for": { "element": "Proxy", "where": "hasStereotype('Implementation')" }, "each": "stereotype('Implementation')['Owned Files']", "value": "'present'", "discriminator": "item.Path", "bindings": { "File": "item.Path" }, "own": ["File"], "source": "the Implementation stereotype's Owned Files" },
        { "kind": "component.kind", "for": { "element": "Page" }, "value": "'Page'", "bindings": { "Component": "name", "Folder": "if(parent.specialization == 'Folder', parent.name, '')" }, "own": ["Component", "Folder"], "dependsOn": "type.exists", "source": "the element type" },
        { "kind": "component.kind", "for": { "element": "Dialog" }, "value": "'Dialog'", "bindings": { "Component": "name", "Folder": "if(parent.specialization == 'Folder', parent.name, '')" }, "own": ["Component", "Folder"], "dependsOn": "type.exists", "source": "the element type" },
        { "kind": "component.kind", "for": { "element": "Component" }, "value": "if(hasStereotype('Page'), 'Page', if(hasStereotype('Dialog'), 'Dialog', 'Component'))", "bindings": { "Component": "name", "Folder": "if(parent.specialization == 'Folder', parent.name, '')" }, "own": ["Component", "Folder"], "dependsOn": "type.exists", "source": "the element type, or the component's Page or Dialog stereotype" },
        { "kind": "component.kind", "for": { "element": "Layout" }, "value": "'Layout'", "bindings": { "Component": "name", "Folder": "if(parent.specialization == 'Folder', parent.name, '')" }, "own": ["Component", "Folder"], "dependsOn": "type.exists", "source": "the element type" },
        { "kind": "security", "for": { "element": "Page" }, "value": "if(hasStereotype('Unsecured'), 'Unsecured', if(hasStereotype('Secured'), 'Secured', 'None'))", "dependsOn": "type.exists", "source": "the page's Secured or Unsecured stereotype" },
        { "kind": "security", "for": { "element": "Dialog" }, "value": "if(hasStereotype('Unsecured'), 'Unsecured', if(hasStereotype('Secured'), 'Secured', 'None'))", "dependsOn": "type.exists", "source": "the dialog's Secured or Unsecured stereotype" },
        { "kind": "security", "for": { "element": "Component" }, "value": "if(hasStereotype('Unsecured'), 'Unsecured', if(hasStereotype('Secured'), 'Secured', 'None'))", "dependsOn": "type.exists", "source": "the component's Secured or Unsecured stereotype" },
        { "kind": "security", "for": { "element": "Layout" }, "value": "if(hasStereotype('Unsecured'), 'Unsecured', if(hasStereotype('Secured'), 'Secured', 'None'))", "dependsOn": "type.exists", "source": "the layout's Secured or Unsecured stereotype" },
        { "kind": "security.roles", "for": { "element": "Page", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Roles", "dependsOn": "type.exists", "waitsOn": ["security"], "source": "the page's Secured Roles" },
        { "kind": "security.roles", "for": { "element": "Dialog", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Roles", "dependsOn": "type.exists", "waitsOn": ["security"], "source": "the dialog's Secured Roles" },
        { "kind": "security.roles", "for": { "element": "Component", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Roles ?? join(map(stereotype('Secured')['Security Roles'], name), ', ')", "dependsOn": "type.exists", "waitsOn": ["security"], "source": "the component's Secured Roles" },
        { "kind": "security.roles", "for": { "element": "Layout", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Roles", "dependsOn": "type.exists", "waitsOn": ["security"], "source": "the layout's Secured Roles" },
        { "kind": "security.policy", "for": { "element": "Page", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Policy", "dependsOn": "type.exists", "waitsOn": ["security"], "source": "the page's Secured Policy" },
        { "kind": "security.policy", "for": { "element": "Dialog", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Policy", "dependsOn": "type.exists", "waitsOn": ["security"], "source": "the dialog's Secured Policy" },
        { "kind": "security.policy", "for": { "element": "Component", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Policy", "dependsOn": "type.exists", "waitsOn": ["security"], "source": "the component's Secured Policy" },
        { "kind": "security.policy", "for": { "element": "Layout", "where": "hasStereotype('Secured')" }, "value": "stereotype('Secured').Policy", "dependsOn": "type.exists", "waitsOn": ["security"], "source": "the layout's Secured Policy" },
        { "kind": "page.route", "for": { "element": "Page" }, "value": "split(stereotype('Page').Route, ',')", "bindings": { "Component": "name", "Page": "name", "Route": "trimStart(stereotype('Page').Route, '/')" }, "own": ["Component", "Page", "Route"], "dependsOn": "type.exists", "source": "the Page stereotype's Route" },

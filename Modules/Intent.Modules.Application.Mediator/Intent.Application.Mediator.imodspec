  <decorators></decorators>
  <factoryExtensions />
  <moduleSettings>
    <group id="ad217e62-f3f2-4ec8-8ccf-62272a3e31e4" title="Mediator Settings" type="application-settings" externalReference="ad217e62-f3f2-4ec8-8ccf-62272a3e31e4">
      <settings>
        <setting id="17fd2373-eaca-4109-846d-2f55123ad2c5" title="Enable logging behaviour" type="switch">
          <hint>Log every command and query, with the current user, before it is handled. Opt in; the behaviour logs without a user when Intent.Application.Identity is not installed.</hint>
          <defaultValue>false</defaultValue>
        </setting>
        <setting id="a6ffb57a-8f07-445a-affd-0b0a4341bd8d" title="Enable performance behaviour" type="switch">
          <hint>Warn when a command or query takes longer than 500 ms to handle. Opt in.</hint>
          <defaultValue>false</defaultValue>
        </setting>
        <setting id="e2428551-ac90-4ba3-9357-cd7fbb9da3f4" title="Enable unhandled exception behaviour" type="switch">
          <hint>Log unhandled exceptions from commands and queries (validation exceptions are rethrown unlogged). Opt in.</hint>
          <defaultValue>false</defaultValue>
        </setting>
      </settings>
    </group>
  </moduleSettings>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Intent.Modules.Guardrails.Contracts.Tests" />
  </ItemGroup>


  <ItemGroup><!-- Supplied at run time by Intent.OutputManager.RoslynWeaver's lib folder (Roslyn 5.0), so it isn't shipped. Keep it at or below that version. -->

    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup><!-- The move runs the drift engine to bring the model into line with the code. Intent.Common.DriftEngine ships these assemblies, and the task host loads them from its lib folder, so they aren't shipped here or passed on to the Guardrails modules. -->

    <ProjectReference Include="..\Intent.Modules.Common.DriftEngine.Core\Intent.Modules.Common.DriftEngine.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Intent.Modules.Common.DriftEngine.Stacks\Intent.Modules.Common.DriftEngine.Stacks.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup><!-- The migration's persistence model. The client supplies both at run time; 3.7.4 is the first with item-list rows. -->
  
    <PackageReference Include="Intent.Architect.Persistence" Version="3.7.4" />
    <PackageReference Include="Intent.Modules.Common" Version="3.11.1" />
    <PackageReference Include="Intent.Modules.Common.CSharp" Version="3.10.12-pre.2" />
    <PackageReference Include="Intent.Modules.Common.DriftReporting" Version="1.0.0-pre.0" />
    <PackageReference Include="Intent.Packager" Version="3.6.2-pre.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Intent.Persistence.SDK" Version="1.0.3" />
    <PackageReference Include="Intent.RoslynWeaver.Attributes" Version="3.0.0" />
    <!-- 3.14.0 is the drift engine's. Private, so the Guardrails modules keep the 3.14.0-pre.1 they reference themselves. -->
    <PackageReference Include="Intent.SoftwareFactory.SDK" Version="3.14.0" PrivateAssets="all" />
  </ItemGroup>

</Project>

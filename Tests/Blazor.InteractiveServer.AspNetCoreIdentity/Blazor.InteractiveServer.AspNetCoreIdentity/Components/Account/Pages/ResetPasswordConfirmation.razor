@page "/Account/ResetPasswordConfirmation"

<PageTitle>Reset Password Confirmation</PageTitle>

<MudPaper Class="pa-4 mb-4 ux-gradient-primary" Elevation="0">
    <MudText Typo="Typo.h4" Class="text-white font-weight-bold mb-2">
        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Class="mr-2" />
        Reset password confirmation
    </MudText>
    <MudText Typo="Typo.body1" Class="text-white opacity-90">
        Your password has been successfully updated.
    </MudText>
</MudPaper>

<MudCard Class="ux-fade-in-up auth-form-shell" Style="animation-delay: 0.1s" Outlined="true">
    <MudCardContent>
        <MudText Typo="Typo.h5" Class="mb-3">Password reset complete</MudText>
        <MudText Typo="Typo.body1">Your password has been reset. Please <MudLink Href="Account/Login">click here to log in</MudLink>.</MudText>
    </MudCardContent>
</MudCard>

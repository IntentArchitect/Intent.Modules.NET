  <properties>
    <property id="11d2548c-4d37-4c5d-ab7b-ba60b4bc61be">
      <hint>Optional. The existing file's name, with or without .cs; the file stays in this element's folder. With .cs the name is used exactly as written, so include it when the name starts or ends with a space (e.g. abc .cs); without it, surrounding spaces are trimmed. Elements with the same Filename in the same folder are generated into one file.</hint>
      <name>Filename</name>
      <type>string</type>
      <controlType>text</controlType>
      <optionsSource>n/a</optionsSource>
      <placeholder>e.g. orderEntities</placeholder>
    </property>
    <property id="e9476ee3-2e32-427f-95b2-938c8fb8397b">
      <hint>Optional. Overrides the namespace derived from the element's folders. Every type sharing a file must have the same namespace.</hint>
      <name>Namespace</name>
      <type>string</type>
      <controlType>text</controlType>
      <optionsSource>n/a</optionsSource>
      <placeholder>e.g. Basislink.Domain</placeholder>
    </property>
    <property id="df085ba5-b5b5-44f2-9690-51f3c8053736">
      <hint>Optional. Tick when the type is declared in the global namespace (no namespace declaration in the file). Leave Namespace empty.</hint>
      <name>No Namespace</name>
      <type>string</type>
      <controlType>checkbox</controlType>
      <optionsSource>n/a</optionsSource>
      <defaultValue>false</defaultValue>
    </property>
  </properties>

  <stereotypes>
    <stereotype stereotypeDefinitionId="14441454-bfe0-4d5d-8dba-d86d74d33a3b" name="AI Settings">
      <definitionPackageName>Intent.ModuleBuilder</definitionPackageName>
      <definitionPackageId>9972b2a9-b749-4bba-b5c8-824bf694c6ef</definitionPackageId>
      <properties>
        <property name="17477a69-d9a5-4251-9329-0963e8121b5f" display="Rules" value="- Use this association when an application's code keeps its own copy of an integration command that another application sends (a brownfield receiver guarded by Intent.Services.Guardrails.Contracts). This is the one exception to the Eventing rule that a message is modelled once and referenced elsewhere.&#xA;- Model the copy as an Integration Command in this application's own Eventing Package, named and shaped as in the code, then right-click it and choose Link To Sent Integration Command to link it to the sender's Integration Command.&#xA;- Always draw it from the copy to the sent command, one link per copy. Only an Integration Command links to an Integration Command; use Integration Event Subscription for events.&#xA;- The copy's Eventing Package must reference the sender's Eventing Package, or the sent command can't be targeted. If that package reference is missing, add it to the copy's package before linking.&#xA;- If the sent command isn't modelled anywhere in the solution, model the copy without a link and report it.&#xA;- The link documents the flow between applications; nothing is generated from it. This application's handlers subscribe to the copy, the type the code handles." />
      </properties>
    </stereotype>
  </stereotypes>

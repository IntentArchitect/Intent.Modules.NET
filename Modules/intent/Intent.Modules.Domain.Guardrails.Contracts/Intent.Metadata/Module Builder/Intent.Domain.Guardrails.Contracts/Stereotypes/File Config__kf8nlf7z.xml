  <targetMode>of-type</targetMode>
  <targetTypes>
    <type id="04e12b51-ed12-42a3-9667-a6aa81bb6d10">Class</type>
    <type id="5fe6bb0a-7fc3-42ae-a351-d9188f5b8bc5">Value Object</type>
    <type id="96ffceb2-a70a-4b69-869b-0df436c470c3">Repository</type>

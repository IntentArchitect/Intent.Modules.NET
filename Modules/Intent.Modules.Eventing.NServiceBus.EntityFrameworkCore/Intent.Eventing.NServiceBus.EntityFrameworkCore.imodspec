<?xml version="1.0" encoding="utf-8"?>
<package>
  <id>Intent.Eventing.NServiceBus.EntityFrameworkCore</id>
  <version>1.0.0-pre.0</version>
  <supportedClientVersions>[5.0.0-a, 6.0.0-a)</supportedClientVersions>
  <summary>Integrates NServiceBus with Entity Framework Core to provide a transactional outbox using SQL persistence.</summary>
  <description>Integrates NServiceBus with Entity Framework Core to provide a transactional outbox using SQL persistence. Requires the Intent.Eventing.NServiceBus module with OutboxPattern set to EntityFramework.</description>
  <authors>Intent.Modules.NET</authors>
  <tags>csharp dotnet eventing nservicebus entityframework ef outbox</tags>
  <templates></templates>
  <decorators />
  <factoryExtensions>
    <factoryExtension id="Intent.Eventing.NServiceBus.EntityFrameworkCore.EFOutboxPatternConfiguratorExtension" externalReference="a1b2c3d4-e5f6-7890-abcd-ef1234567890" />
  </factoryExtensions>
  <moduleSettings></moduleSettings>
  <dependencies>
    <dependency id="Intent.Common" version="3.9.0" />
    <dependency id="Intent.Common.CSharp" version="3.9.0" />
    <dependency id="Intent.EntityFrameworkCore" version="4.5.0" />
    <dependency id="Intent.Eventing.NServiceBus" version="1.0.0-pre.0" />
  </dependencies>
  <files>
    <file src="$outDir$/$id$.dll" />
    <file src="$outDir$/$id$.pdb" />
  </files>
  <moduleSettingsExtensions />
  <metadata />
  <migrations />
</package>

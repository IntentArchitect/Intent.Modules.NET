  <moduleSettings>
    <group id="6cc9ca71-7670-48eb-b413-e47e72307cbd" title="C# Style Configuration">
      <module>Intent.Common.CSharp</module>
      <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
      <settings>
        <setting id="727bb639-f91c-4f86-bd81-b1eccd7e4d45" title="Blank line between Members" module="Intent.Common.CSharp" type="select">
          <hint>Apply empty lines between properties and fields.</hint>
          <value>default</value>
          <isRequired>false</isRequired>
          <options>
            <option value="default" description="Default" />
            <option value="always" description="Always" />
          </options>
        </setting>
        <setting id="0c43b221-fec0-4df7-96d2-e7281ddf9207" title="Constructor Initializer" module="Intent.Common.CSharp" type="select">
          <hint>Constructor initializers placement. More information can be found in the [readme](https://github.com/IntentArchitect/Intent.Modules/blob/master/Modules/Intent.Modules.Common.CSharp/README.md). Relates to [StyleCop rule SA1128](https://github.com/DotNetAnalyzers/StyleCopAnalyzers/blob/master/documentation/SA1128.md)</hint>
          <value>same-line</value>
          <isRequired>false</isRequired>
          <options>
            <option value="same-line" description="Same line" />
            <option value="new-line" description="New line" />
            <option value="depends-on-length" description="Depends on length" />
          </options>
        </setting>
        <setting id="6483b559-92bb-43d7-a0b4-af20ded10a1b" title="Parameter Placement" module="Intent.Common.CSharp" type="select">
          <hint>Parameter placement. More information can be found in the [readme](https://github.com/IntentArchitect/Intent.Modules/blob/master/Modules/Intent.Modules.Common.CSharp/README.md). Relates to [StyleCop rule SA1116](https://github.com/DotNetAnalyzers/StyleCopAnalyzers/blob/master/documentation/SA1116.md)</hint>
          <value>default</value>
          <isRequired>false</isRequired>
          <options>
            <option value="same-line" description="Same Line" />
            <option value="depends-on-length" description="Depends on length" />
            <option value="default" description="Default" />
          </options>
        </setting>
      </settings>
    </group>
    <group id="ac0a788e-d8b3-4eea-b56d-538608f1ded9" title="Database Settings">
      <module>Intent.Metadata.RDBMS</module>
      <icon type="UrlImagePath" source="data:image/png;base64," />
      <settings>
        <setting id="684582e0-125a-4ddd-a950-714e2af41f15" title="Decimal precision and scale" module="Intent.Metadata.RDBMS" type="text">
          <hint>Format : precision, scale e.g. 16,4</hint>
          <isRequired>false</isRequired>
          <options />
        </setting>
        <setting id="5aca6e0c-1b64-425b-9046-f0bc81c44311" title="Key Creation Mode" module="Intent.Metadata.RDBMS" type="select">
          <hint>If and how the designer should create and manage the PKs and FKs</hint>
          <value>manual</value>
          <isRequired>false</isRequired>
          <options>
            <option value="manual" description="Manually add PKs and FKs" />
            <option value="explicit" description="Explicitly add PKs and FKs automatically" />
          </options>
        </setting>
        <setting id="ef83f85d-bb8d-4b10-8842-9f35f9f54165" title="Key Type" module="Intent.Metadata.RDBMS" type="select">
          <hint>Select the default data type to be used for all surrogate and foreign keys.</hint>
          <value>guid</value>
          <isRequired>false</isRequired>
          <options>
            <option value="guid" description="guid" />
            <option value="long" description="long" />
            <option value="int" description="int" />
          </options>
        </setting>
      </settings>
    </group>
    <group id="cfc23486-153d-4d9d-9e0b-cfeb1754e382" title="Domain Guardrails Contracts Settings">
      <module>Intent.Domain.Guardrails.Contracts</module>
      <icon type="UrlImagePath" source="data:image/png;base64," />
      <settings>
        <setting id="4bfe1393-e432-4171-870a-3f662cc61898" title="Default Type Modifiers" module="Intent.Domain.Guardrails.Contracts" type="select">
          <hint>The modifiers every class and record contract is declared with, unless its Type Configuration sets Modifiers. An option without public or internal declares types without an access modifier, and none declares them with no modifiers at all. sealed is left off abstract types and types another modelled type inherits from. Enums take only the access modifier, unless their Enum Configuration sets one.</hint>
          <value>public</value>
          <isRequired>false</isRequired>
          <options>
            <option value="public" description="public" />
            <option value="internal" description="internal" />
            <option value="public sealed" description="public sealed" />
            <option value="internal sealed" description="internal sealed" />
            <option value="public partial" description="public partial" />
            <option value="internal partial" description="internal partial" />
            <option value="public sealed partial" description="public sealed partial" />
            <option value="internal sealed partial" description="internal sealed partial" />
            <option value="none" description="none" />
            <option value="sealed" description="sealed" />
            <option value="partial" description="partial" />
            <option value="sealed partial" description="sealed partial" />
          </options>
        </setting>
      </settings>
    </group>
    <group id="0ecca7c5-96f7-449a-96b9-f65ba0a4e3ad" title="Domain Interaction Settings">
      <module>Intent.Modelers.Services.DomainInteractions</module>
      <icon type="UrlImagePath" source="data:image/png;base64," />
      <settings>
        <setting id="14bc1e98-930b-494c-97a9-5da4e1f3a5fa" title="Default Mapping Mode" module="Intent.Modelers.Services.DomainInteractions" type="select">
          <hint>Determines which mapping Services designer CRUD scripts will execute</hint>
          <value>advanced</value>
          <isRequired>false</isRequired>
          <options>
            <option value="basic" description="Basic Mapping" />
            <option value="advanced" description="Advanced Mapping" />
          </options>
        </setting>
        <setting id="61ced3b4-e1d8-4274-b84d-d9b8e0c3143f" title="Default Query Implementation" module="Intent.Modelers.Services.DomainInteractions" type="select">
          <value>default</value>
          <isRequired>false</isRequired>
          <options>
            <option value="default" description="Default" />
            <option value="project-to" description="Project To" />
          </options>
        </setting>
        <setting id="4a1bc3ad-9ec2-499e-99d8-beba03a1d5bb" title="Null Child Update Implementation" module="Intent.Modelers.Services.DomainInteractions" type="select">
          <hint>How NULL child entities should be handled when [updating a domain entity.](https://docs.intentarchitect.com/articles/modules-common/intent-modelers-services-domaininteractions/intent-modelers-services-domaininteractions.html#null-child-update-implementation)</hint>
          <value>set-to-null</value>
          <isRequired>false</isRequired>
          <options>
            <option value="ignore" description="Ignore" />
            <option value="set-to-null" description="Set to NULL" />
          </options>
        </setting>
      </settings>
    </group>

@inherits LayoutComponentBase
@layout <#= LayoutNamespace #>Components.Layout.MainLayout

@if (HttpContext is null)
{
    <p>Loading...</p>
}
else
{
    <div class="ux-manage">
        <AccountHero Icon="user"
                     Title="Manage your account"
                     Subtitle="Change your account settings." />
        <div class="ux-manage-grid">
            <div class="ux-manage-nav">
                <ManageNavMenu />
            </div>
            <div class="ux-manage-content">
                @Body
            </div>
        </div>
    </div>
}

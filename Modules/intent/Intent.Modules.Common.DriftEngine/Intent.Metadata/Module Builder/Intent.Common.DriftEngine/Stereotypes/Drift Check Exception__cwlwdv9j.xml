  <displayFunction>const matches = (properties["Match"].value ?? "").split("\n").map(x =&gt; x.trim()).filter(x =&gt; x.length &gt; 0);
const reason = properties["Reason"].value;
return `${matches.join(", ")}${reason ? ` — ${reason}` : ""}`;</displayFunction>

        { "kind": "type.exists", "for": { "element": "UI Service" }, "value": "self", "bindings": { "Name": "name", "Module": "name", "Folder": "if(parent.specialization == 'Folder', parent.name, '')", "Path": "stereotype('Implementation').Path" }, "own": ["Name", "Module", "Folder"], "source": "the UI service" },

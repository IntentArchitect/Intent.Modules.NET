@page "/templates/pages/customers/view/{CustomerId:guid}"
@using UI.AI.Samples.Domain

<div class="ux-gradient-primary ux-rounded-lg p-4 mb-4">
    <h1 class="h4 fw-bold text-white mb-2">View Customer</h1>
    <p class="text-white mb-0" style="opacity:.9">Read-only view of this customer's details.</p>
</div>

<div class="card ux-fade-in-up">
    <div class="card-body">
        @if (CustomerByIdModels is null)
        {
            <div class="d-flex flex-column align-items-center justify-content-center" style="min-height:200px">
                <div class="spinner-border" role="status" aria-hidden="true"></div>
                <p class="mt-2">Loading customer...</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="form-label text-uppercase small">Name</div>
                    <div>@CustomerByIdModels.Name</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-label text-uppercase small">Surname</div>
                    <div>@CustomerByIdModels.Surname</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-label text-uppercase small">Email</div>
                    <div>@CustomerByIdModels.Email</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-label text-uppercase small">Category</div>
                    <div>@CustomerByIdModels.CategoryName</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-label text-uppercase small">Sub Category</div>
                    <div>@CustomerByIdModels.SubCategoryName</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-label text-uppercase small">Status</div>
                    @if (CustomerByIdModels.IsActive)
                    {
                        <span class="badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge-neutral">Inactive</span>
                    }
                </div>

                <div class="col-12">
                    <hr class="my-4" />
                    <h2 class="h6">Preferences</h2>
                </div>
                <div class="col-12">
                    <span class="@(CustomerByIdModels.Preference.NewsLetter ? "badge-success" : "badge-neutral") me-2">
                        Newsletter: @(CustomerByIdModels.Preference.NewsLetter ? "Yes" : "No")
                    </span>
                    <span class="@(CustomerByIdModels.Preference.Specials ? "badge-success" : "badge-neutral")">
                        Specials: @(CustomerByIdModels.Preference.Specials ? "Yes" : "No")
                    </span>
                </div>

                @if (CustomerByIdModels.Loyalty is not null)
                {
                    <div class="col-12">
                        <hr class="my-4" />
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="h6 mb-0">Loyalty</h2>
                            <span class="badge-info">Enabled</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-label text-uppercase small">Loyalty Number</div>
                        <div>@CustomerByIdModels.Loyalty!.LoyaltyNo</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-label text-uppercase small">Points</div>
                        <div>@CustomerByIdModels.Loyalty!.Points</div>
                    </div>
                }

                <div class="col-12">
                    <hr class="my-4" />
                    <h2 class="h6">Addresses</h2>
                </div>

                @if (CustomerByIdModels.Addresses?.Count > 0)
                {
                    @foreach (var a in CustomerByIdModels.Addresses)
                    {
                        <div class="col-12 mb-3">
                            <div class="ux-inner-panel p-3">
                                <div class="row g-3">
                                    <div class="col-12 col-md-3">
                                        <div class="form-label text-uppercase small">Type</div>
                                        <span class="badge-neutral">@((a.AddressType == AddressType.Deliver) ? "Delivery" : "Billing")</span>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        <div class="form-label text-uppercase small">Address line 1</div>
                                        <div>@a.Line1</div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="form-label text-uppercase small">Address line 2</div>
                                        <div>@a.Line2</div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="form-label text-uppercase small">City</div>
                                        <div>@a.City</div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="form-label text-uppercase small">Postal code</div>
                                        <div>@a.Postal</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <span class="text-muted">No addresses captured.</span>
                    </div>
                }

                <div class="col-12 mt-4">
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo($"templates/pages/customers/edit/{CustomerByIdModels.Id}"))">Edit</button>
                        <button type="button" class="btn btn-outline" @onclick="Cancel">Back to list</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@page "/templates/pages/customers"
@using UI.AI.Samples.Application.Customers

<div class="ux-gradient-primary ux-rounded-lg p-4 mb-4">
    <h1 class="h4 fw-bold text-white mb-2">Customers Management</h1>
    <p class="text-white mb-0" style="opacity:.9">View and manage your customer list.</p>
</div>

<div class="card ux-fade-in-up">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label" for="search">Search</label>
                <input id="search" class="form-control" placeholder="Search by name" @bind="SearchText" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" for="activeStatus">Active status</label>
                <select id="activeStatus" class="form-select" @bind="IsActiveText">
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-12">
                <button type="button" class="btn btn-primary me-2" @onclick="NavigateToCustomerAddPage">Add Customer</button>
                <button type="button" class="btn btn-outline-primary" @onclick="ReloadAsync">Search</button>
            </div>
            <div class="col-12">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Surname</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (CustomersModels?.Data is { Count: > 0 })
                        {
                            @foreach (var context in CustomersModels.Data)
                            {
                                <tr>
                                    <td>@context.Name</td>
                                    <td>@context.Surname</td>
                                    <td>@context.Email</td>
                                    <td>
                                        @if (context.IsActive)
                                        {
                                            <span class="badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-outline" title="View" @onclick="@(() => NavigateToCustomerViewPage(context.Id))">View</button>
                                        <button type="button" class="btn btn-outline-primary" title="Edit" @onclick="@(() => NavigateToCustomerEditPage(context.Id))">Edit</button>
                                        <button type="button" class="btn btn-outline-danger" title="Delete" @onclick="@(() => OnDeleteCustomer(context.Id))">Delete</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No customers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (CustomersModels is not null && CustomersModels.TotalCount > PageSize)
                {
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline" disabled="@(PageNo <= 1)" @onclick="PreviousPage">Previous</button>
                        <button type="button" class="btn btn-outline" disabled="@(PageNo * PageSize >= CustomersModels.TotalCount)" @onclick="NextPage">Next</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (_showDeleteConfirm)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>Are you sure you want to delete this customer?</span>
        <span>
            <button type="button" class="btn btn-danger me-2" @onclick="ConfirmDeleteAsync">Delete</button>
            <button type="button" class="btn btn-outline" @onclick="CancelDelete">Cancel</button>
        </span>
    </div>
}

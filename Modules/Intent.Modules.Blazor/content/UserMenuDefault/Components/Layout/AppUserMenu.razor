@* Default user menu — shipped by the base Blazor module when the Authentication module is NOT installed,
   so a layout's <AppUserMenu/> always resolves. The Authentication module ships its own AppUserMenu (the
   real Profile / My Account / Logout menu) and this one defers to it (see
   UserMenuDefaultStaticContentTemplateRegistration). It scaffolds the shared UserMenu chrome with a single
   placeholder hint — the same way an empty drawer prompts you to add nav items — using an inline-SVG
   trigger (no UxIcon/MudIcon dependency) so it renders identically in the plain and MudBlazor stacks. *@

<UserMenu>
    <Trigger>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="12" cy="5" r="2" />
            <circle cx="12" cy="12" r="2" />
            <circle cx="12" cy="19" r="2" />
        </svg>
    </Trigger>
    <ChildContent>
        <span class="ux-user-menu-item ux-user-menu-placeholder">Add menu items</span>
    </ChildContent>
</UserMenu>

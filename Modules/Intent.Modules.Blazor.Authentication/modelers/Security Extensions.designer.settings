<?xml version="1.0" encoding="utf-8"?>
<settings version="3.1.1">
  <id>6d30e652-7e0d-4a43-94ea-614940426a7c</id>
  <name>Security Extensions</name>
  <designerReferences />
  <packageSettings />
  <packageExtensions />
  <elementSettings />
  <elementExtensions>
    <elementExtension type="Component" typeId="b1c481e1-e91e-4c29-9817-00ab9cad4b6b">
      <mappingSettings />
      <macros>
        <macro trigger="on-changed">
          <script>const PAGE_STEREOTYPE_ID = "ea4adc09-8978-4ede-ba5f-265debb2b60c";
const SECURED_STEREOTYPE_ID = "012f5173-6419-4006-a9a8-ab5c20b8a42e";
const PUBLIC_KEYWORDS = ["home","index","landing","error","notfound","404","accessdenied","unauthorized","forbidden","maintenance","login","logon","signin","register","signup","forgotpassword","resetpassword","logout","signout","confirmemail","lockout","externallogin","health","status","public"];

if (element.hasStereotype(PAGE_STEREOTYPE_ID)) {
    const normalizedName = element.getName().toLowerCase().replace(/[^a-z0-9]/g, "");
    const isPublicPage = PUBLIC_KEYWORDS.some(keyword =&gt; normalizedName.includes(keyword));

    if (!isPublicPage &amp;&amp; !element.hasStereotype(SECURED_STEREOTYPE_ID)) {
        element.ensureStereotype(SECURED_STEREOTYPE_ID);
    }
}</script>
        </macro>
        <macro trigger="on-created">
          <script>const PAGE_STEREOTYPE_ID = "ea4adc09-8978-4ede-ba5f-265debb2b60c";
const SECURED_STEREOTYPE_ID = "012f5173-6419-4006-a9a8-ab5c20b8a42e";
const PUBLIC_KEYWORDS = ["home","index","landing","error","notfound","404","accessdenied","unauthorized","forbidden","maintenance","login","logon","signin","register","signup","forgotpassword","resetpassword","logout","signout","confirmemail","lockout","externallogin","health","status","public"];

if (element.hasStereotype(PAGE_STEREOTYPE_ID)) {
    const normalizedName = element.getName().toLowerCase().replace(/[^a-z0-9]/g, "");
    const isPublicPage = PUBLIC_KEYWORDS.some(keyword =&gt; normalizedName.includes(keyword));

    if (!isPublicPage &amp;&amp; !element.hasStereotype(SECURED_STEREOTYPE_ID)) {
        element.ensureStereotype(SECURED_STEREOTYPE_ID);
    }
}</script>
        </macro>
      </macros>
    </elementExtension>
    <elementExtension type="Security Configuration" typeId="0888156b-6645-49b6-8180-77095e20783c">
      <mappingSettings />
    </elementExtension>
  </elementExtensions>
  <associationSettings />
  <associationExtensions />
  <mappingSettings />
  <mappableElementPackages />
  <mappableElementPackageExtensions />
  <scripts />
</settings>
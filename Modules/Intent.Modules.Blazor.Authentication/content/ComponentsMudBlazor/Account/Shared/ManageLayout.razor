@inherits LayoutComponentBase
@layout <#= Namespace #>Components.Layout.MainLayout

@if (HttpContext is null)
{
    <p>Loading...</p>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-3">Manage your account</MudText>

    <MudGrid>
        <MudItem xs="12" md="3">
            <ManageNavMenu />
        </MudItem>
        <MudItem xs="12" md="9">
            @Body
        </MudItem>
    </MudGrid>
}

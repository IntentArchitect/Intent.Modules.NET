<?xml version="1.0" encoding="utf-8"?>
<package>
  <id>Intent.Eventing.NServiceBus</id>
  <version>1.0.3-pre.0</version>
  <supportedClientVersions>[5.0.0-a, 6.0.0-a)</supportedClientVersions>
  <summary>Integrates NServiceBus as the message broker for publishing and subscribing to integration events and commands.</summary>
  <description>Integrates NServiceBus as the message broker for publishing and subscribing to integration events and commands.</description>
  <authors>Intent Architect</authors>
  <iconUrl>data:image/svg+xml;base64,</iconUrl>
  <templates>
    <template id="Intent.Eventing.NServiceBus.NServiceBusConfiguration" externalReference="541e259d-2cd9-4c57-8a8f-d36f7eb21daf">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Infrastructure.DependencyInjection.NServiceBus</role>
      <location>Configuration</location>
    </template>
    <template id="Intent.Eventing.NServiceBus.NServiceBusMessageBus" externalReference="3915ea52-60d2-46e0-a827-44859cf211d0">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Infrastructure.Eventing.NServiceBusEventBus</role>
      <location>Eventing</location>
    </template>
    <template id="Intent.Eventing.NServiceBus.NServiceBusMessageHandler" externalReference="17b4280e-2f8f-41c0-a70d-166cd3e351a8">
      <config>
        <add key="ClassName" description="Class name formula override (e.g. '${Model.Name}')" />
        <add key="Namespace" description="Class namespace formula override (e.g. '${Project.Name}'" />
      </config>
      <role>Infrastructure.Eventing.MessageHandler</role>
      <location>Eventing</location>
    </template>
  </templates>
  <decorators></decorators>
  <factoryExtensions>
    <factoryExtension id="Intent.Eventing.NServiceBus.NServiceBusMessageBusInteropExtension" externalReference="fdeb5fbe-21ee-4545-a874-df29642b61aa" />
    <factoryExtension id="Intent.Eventing.NServiceBus.NServiceBusRegistrationExtension" externalReference="99e6d024-7e01-4b4c-a56a-9dbb2aa8b836" />
  </factoryExtensions>
  <moduleSettings>
    <group id="76e5fbf4-95c3-4d3e-8343-0969c4a67df6" title="NServiceBus Settings" type="application-settings" externalReference="76e5fbf4-95c3-4d3e-8343-0969c4a67df6">
      <settings>
        <setting id="537d4def-c538-417c-bada-a785c14195b3" title="Transport" type="select">
          <defaultValue>learning-transport</defaultValue>
          <options>
            <option value="rabbitmq" description="RabbitMQ" />
            <option value="azure-service-bus" description="Azure Service Bus" />
            <option value="amazon-sqs" description="AmazonSQS" />
            <option value="learning-transport" description="Learning Transport" />
            <option value="sql-server" description="SQL Server" />
          </options>
        </setting>
        <setting id="4060477a-191f-43be-a2c1-f2dd94ff00e2" title="Recoverability Policy" type="select">
          <hint>Controls which retry blocks are generated.</hint>
          <defaultValue>immediate-and-delayed</defaultValue>
          <options>
            <option value="none" description="None" />
            <option value="immediate-only" description="Immediate Only" />
            <option value="delayed-only" description="Delayed Only" />
            <option value="immediate-and-delayed" description="Immediate And Delayed" />
          </options>
        </setting>
        <setting id="61e27361-13e1-46ad-834f-3c98088c3947" title="Persistence" type="select">
          <hint>Persistence provider for subscriptions and outbox exactly-once dispatch.</hint>
          <defaultValue>none</defaultValue>
          <options>
            <option value="none" description="None" />
            <option value="sql-persistence" description="SQL Persistence" />
            <option value="nhibernate" description="NHibernate" />
          </options>
        </setting>
        <setting id="a249c7a3-2d67-4973-83ab-3f4873fe35ab" title="Enable Outbox" type="checkbox">
          <hint>Enables the transactional outbox. Requires SQL Persistence or NHibernate.</hint>
          <defaultValue>false</defaultValue>
        </setting>
        <setting id="40a8127e-e253-47c9-aa90-ec93a4fca0fa" title="Enable Audit Queue" type="checkbox">
          <hint>Generates audit queue config. Set NServiceBus:AuditQueue in appsettings.json.</hint>
          <defaultValue>false</defaultValue>
        </setting>
        <setting id="6321cb9f-0357-440f-99da-b8ab01e37914" title="Enable Instance Identification" type="checkbox">
          <hint>Generates instance identification for Particular monitoring. Set NServiceBus:InstanceId in appsettings.json.</hint>
          <defaultValue>false</defaultValue>
        </setting>
      </settings>
    </group>
  </moduleSettings>
  <dependencies>
    <dependency id="Intent.Common" version="3.11.0" />
    <dependency id="Intent.Common.CSharp" version="3.10.11" />
    <dependency id="Intent.Common.Types" version="4.1.3" />
    <dependency id="Intent.Eventing.Contracts" version="6.1.0" />
    <dependency id="Intent.Modelers.Eventing" version="6.0.3" />
    <dependency id="Intent.Modelers.Services" version="4.0.7" />
    <dependency id="Intent.Modelers.Services.EventInteractions" version="2.0.0" />
    <dependency id="Intent.OutputManager.RoslynWeaver" version="5.0.1" />
  </dependencies>
  <interoperability>
    <detect id="Intent.EntityFrameworkCore">
      <install>
        <package id="Intent.EntityFrameworkCore" version="5.0.46" />
      </install>
    </detect>
    <detect id="Intent.VisualStudio.Projects">
      <install>
        <package id="Intent.VisualStudio.Projects" version="4.1.8" />
      </install>
    </detect>
  </interoperability>
  <files>
    <file src="$outDir$/$id$.dll" />
    <file src="$outDir$/$id$.pdb" />
  </files>
  <tags>NServiceBus eventing message-broker integration-events integration-commands publish subscribe RabbitMQ Azure-Service-Bus Amazon-SQS outbox recoverability</tags>
  <moduleSettingsExtensions />
  <metadata>
    <install target="Module Builder;Services" src="Intent.Metadata/Module Builder/Intent.Eventing.NServiceBus/Intent.Eventing.NServiceBus.pkg.config" externalReference="62ed1010-b7ea-41be-8a1e-617d3d8b5f8b" />
    <install target="Services" src="modelers/NServiceBus Settings.designer.settings" externalReference="b0319bd7-d378-42db-b58a-beb886c99560" />
  </metadata>
  <releaseNotes>release-notes.md</releaseNotes>
  <migrations />
</package>
<stereotypeDefinition id="38da9465-4099-4b22-ac5a-a01cde22dec2" version="3.1.0">
  <comment>Explicitly sets the Service Proxy operation's async shape: Async Mode (async, no async keyword or sync), Task Type, and the CancellationToken parameter. Without it, an operation is async when its name ends in Async: the async keyword, a Task return type and CancellationToken cancellationToken = default. An interface method never has the async keyword.</comment>
  <name>Async Configuration</name>
  <targetMode>filter-function</targetMode>
  <targetFilterFunction>// Operation (on a Service Proxy)
return ["aee6811e-b2f6-4562-a8eb-502029f63bc8"].indexOf(element.specializationId) &gt;= 0;</targetFilterFunction>
  <traitStorage>package</traitStorage>
  <applyMode>manually</applyMode>
  <icon type="UrlImagePath" source="data:image/png;base64," />
  <displayIcon>false</displayIcon>
  <displayIconFunction>return false;</displayIconFunction>
  <displayAsAnnotation>false</displayAsAnnotation>
  <displayAsText>true</displayAsText>
  <autoAdd>false</autoAdd>
  <allowMultipleApplies>false</allowMultipleApplies>
  <parentFolderId>d1b06837-852d-4218-8833-37d9c0552d1d</parentFolderId>
  <order>0</order>
  <packageId>5c3db0f8-a7c9-4afc-b9dd-ca5d5a22674d</packageId>
  <packageName>Intent.Services.Guardrails.Contracts</packageName>
  <properties>
    <property id="b82f3fd2-7147-4f2c-a75b-6584b755f184">
      <hint>Append a CancellationToken parameter. Not used when Async Mode is sync.</hint>
      <name>Include Cancellation Token</name>
      <type>string</type>
      <controlType>checkbox</controlType>
      <optionsSource>n/a</optionsSource>
      <defaultValue>true</defaultValue>
    </property>
    <property id="48ff7dfe-d6b8-4c41-bb48-c43b6d89e4a8">
      <hint>async: the async keyword and a Task or ValueTask return type. no async keyword: the same return type without async, for a method that returns the task directly, e.g. =&gt; _inner.FindAsync(id). sync: the return type exactly as modelled, with no CancellationToken. An interface method never has the async keyword, so async and no async keyword write the same interface method.</hint>
      <name>Async Mode</name>
      <type>string</type>
      <controlType>select</controlType>
      <optionsSource>options</optionsSource>
      <defaultValue>async</defaultValue>
      <valueOptions>
        <option>async</option>
        <option>no async keyword</option>
        <option>sync</option>
      </valueOptions>
    </property>
    <property id="9a2d0802-e9ae-4f1b-a64b-74599d35050a">
      <hint>Task, ValueTask or void. Empty means Task, or ValueTask when the return type is modelled as one. An explicit Task or ValueTask also converts a return type modelled as Task or ValueTask. void writes async void, e.g. for an event handler: only with Async Mode async, on an operation with no return type. Not used when Async Mode is sync.</hint>
      <name>Task Type</name>
      <type>string</type>
      <controlType>select</controlType>
      <optionsSource>options</optionsSource>
      <valueOptions>
        <option>Task</option>
        <option>ValueTask</option>
        <option>void</option>
      </valueOptions>
    </property>
    <property id="32bcde4b-4a9c-4da6-a83e-02b644c28cd3">
      <hint>The CancellationToken parameter's name when the code doesn't call it cancellationToken, e.g. ct. Empty means cancellationToken. Method signatures are fully managed, so any other name in the code is otherwise renamed.</hint>
      <name>Cancellation Token Name</name>
      <type>string</type>
      <controlType>text</controlType>
      <optionsSource>n/a</optionsSource>
      <placeholder>cancellationToken</placeholder>
    </property>
    <property id="6deb3923-9e1e-4af7-8ca1-541ecf64360e">
      <hint>Write = default on the CancellationToken parameter. Untick when the code declares it without a default.</hint>
      <name>Cancellation Token Default</name>
      <type>string</type>
      <controlType>checkbox</controlType>
      <optionsSource>n/a</optionsSource>
      <defaultValue>true</defaultValue>
    </property>
  </properties>
</stereotypeDefinition>
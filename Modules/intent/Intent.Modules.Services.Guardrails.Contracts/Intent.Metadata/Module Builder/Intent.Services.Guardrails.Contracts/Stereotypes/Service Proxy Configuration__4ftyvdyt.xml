<stereotypeDefinition id="35cf5540-f14a-4ef3-ae22-f9d24aa9c90a" version="3.1.0">
  <comment>Overrides how the Service Proxy contract is declared: Type sets class (the concrete client, the default) or interface (only for a client whose implementation is generated at runtime, e.g. Refit), Modifiers sets its modifiers (empty means the Default Type Modifiers module setting).</comment>
  <name>Service Proxy Configuration</name>
  <targetMode>filter-function</targetMode>
  <targetFilterFunction>// Service Proxy
return ["07d8d1a9-6b9f-4676-b7d3-8db06299e35c"].indexOf(element.specializationId) &gt;= 0;</targetFilterFunction>
  <traitStorage>package</traitStorage>
  <applyMode>manually</applyMode>
  <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
  <displayIcon>false</displayIcon>
  <displayIconFunction>return false;</displayIconFunction>
  <displayAsAnnotation>false</displayAsAnnotation>
  <displayAsText>true</displayAsText>
  <autoAdd>false</autoAdd>
  <allowMultipleApplies>false</allowMultipleApplies>
  <parentFolderId>d1b06837-852d-4218-8833-37d9c0552d1d</parentFolderId>
  <order>0</order>
  <packageId>5c3db0f8-a7c9-4afc-b9dd-ca5d5a22674d</packageId>
  <packageName>Intent.Services.Guardrails.Contracts</packageName>
  <properties>
    <property id="65403563-3d4e-40cb-ba7a-8d139885476e">
      <hint>class: the concrete client class, the default. interface: only when the code has no concrete client class because its implementation is generated at runtime, e.g. a Refit interface. Empty means class.</hint>
      <name>Type</name>
      <type>string</type>
      <controlType>select</controlType>
      <optionsSource>options</optionsSource>
      <defaultValue>class</defaultValue>
      <valueOptions>
        <option>class</option>
        <option>interface</option>
      </valueOptions>
    </property>
    <property id="98482d1f-1287-4d7a-b42f-385816cc9952">
      <hint>Optional. The type's modifiers when they differ from the Default Type Modifiers module setting, e.g. internal sealed. For a class use at most one of public or internal, plus any of sealed, abstract, static, partial; for an interface use at most one of public or internal, plus partial. Leave the access modifier out when the code has none, or use none for no modifiers at all.</hint>
      <name>Modifiers</name>
      <type>string</type>
      <controlType>text</controlType>
      <optionsSource>n/a</optionsSource>
      <placeholder>e.g. internal sealed</placeholder>
    </property>
  </properties>
</stereotypeDefinition>